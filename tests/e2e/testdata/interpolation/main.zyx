package main

import "std/fmt"

struct Point {
    x: i64
    y: i64
    impl Show {
        func Show(w: Buf) {
            w.WriteStr("(")
            w.WriteStr(f"{self.x}")
            w.WriteStr(", ")
            w.WriteStr(f"{self.y}")
            w.WriteStr(")")
        }
    }
}

func main() {
    var name = "world"
    fmt.Println(f"hello, {name}")
    var n = 42
    var x = 2.5
    var ok = true
    var ch = 'A'
    fmt.Println(f"{n}|{x}|{ok}|{ch}|{name}")
    var p = Point { x: 1, y: 2}
    fmt.Println(f"p = {p}")
    fmt.Println(f"")
}
