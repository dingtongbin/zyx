package main

import "std/fmt"
import "std/toml"

// printText writes a string with the bytes that would break the line named
// instead.
func printText(s: str) {
    var i: usize = 0
    for i < s.Len() {
        var b = s[i]
        if b == u8(u32('\n')) {
            fmt.Print("\\n")
        } else if b == u8(u32('\t')) {
            fmt.Print("\\t")
        } else {
            fmt.PrintChar(char(u32(b)))
        }
        i += 1
    }
}

// printNumber writes a number, and the names the format gives the values that
// are not numbers.
func printNumber(n: f64) {
    if n != n {
        fmt.Print("nan")
        return
    }
    if n > 1.7976931348623157e308 {
        fmt.Print("inf")
        return
    }
    if n < -1.7976931348623157e308 {
        fmt.Print("-inf")
        return
    }
    fmt.PrintF64(n)
}

// less orders two strings by their bytes, so a reading of a table is the same
// twice.
func less(a: str, b: str) -> bool {
    var n = a.Len()
    if b.Len() < n {
        n = b.Len()
    }
    var i: usize = 0
    for i < n {
        if a[i] != b[i] {
            return a[i] < b[i]
        }
        i += 1
    }
    return a.Len() < b.Len()
}

// sorted answers the keys of a table in byte order.
func sorted(table: Map<str, Value>) -> Array<str> {
    var keys = table.KeyList()
    var i: usize = 1
    for i < keys.Len() {
        var key = keys[i]
        var j = i
        for j > 0 && less(key, keys[j - 1]) {
            keys[j] = keys[j - 1]
            j -= 1
        }
        keys[j] = key
        i += 1
    }
    return keys
}

// printValue writes a value in a form that names every part of it.
func printValue(v: Value) {
    match v {
        Null => {
            fmt.Print("null")
        }
        Bool(b) => {
            fmt.PrintBool(b)
        }
        Num(n) => {
            printNumber(n)
        }
        Str(s) => {
            fmt.Print("\"")
            printText(s)
            fmt.Print("\"")
        }
        Arr(a) => {
            fmt.Print("[")
            var i: usize = 0
            for item in a {
                if i > 0 {
                    fmt.Print(",")
                }
                printValue(item)
                i += 1
            }
            fmt.Print("]")
        }
        Obj(o) => {
            fmt.Print("{")
            var i: usize = 0
            for key in sorted(o) {
                if i > 0 {
                    fmt.Print(",")
                }
                fmt.Print(key)
                fmt.Print("=")
                match o.Get(key) {
                    Some(inner) => {
                        printValue(inner)
                    }
                    None => { }
                }
                i += 1
            }
            fmt.Print("}")
        }
    }
}

// row builds the table that stands for one row of a written array of tables.
func row(n: f64) -> Value {
    var table = new Map<str, Value>()
    table.Insert("n", Value.Num(n))
    return Value.Obj(table)
}

func main() {
    // A value built by hand is written out, and read back. Nothing here came
    // from a document this package read, so what it shows is what the writer
    // makes of a value.
    var root = new Map<str, Value>()
    root.Insert("num", Value.Num(2.0))
    root.Insert("half", Value.Num(0.5))
    root.Insert("text", Value.Str("a\nb\tc"))
    root.Insert("flag", Value.Bool(true))
    root.Insert("a key", Value.Str("spaced"))
    root.Insert("quoted", Value.Str("say \"hello\""))
    var nums = new Array<Value>(0)
    nums.Push(Value.Num(1.0))
    nums.Push(Value.Num(2.0))
    root.Insert("nums", Value.Arr(nums))
    var inner = new Map<str, Value>()
    inner.Insert("x", Value.Num(1.0))
    root.Insert("table", Value.Obj(inner))
    var empty = new Map<str, Value>()
    root.Insert("none", Value.Obj(empty))
    var rows = new Array<Value>(0)
    rows.Push(row(1.0))
    rows.Push(row(2.0))
    root.Insert("rows", Value.Arr(rows))
    var deeper = new Map<str, Value>()
    var deepest = new Map<str, Value>()
    deepest.Insert("y", Value.Bool(false))
    deeper.Insert("deep", Value.Obj(deepest))
    root.Insert("outer", Value.Obj(deeper))

    var out = new Buf(0)
    toml.Encode(out, Value.Obj(root))
    fmt.Print("written: ")
    printText(out.Str())
    fmt.PrintNl()
    fmt.Print("read back: ")
    match toml.Parse(out.Str()) {
        Ok(v) => {
            printValue(v)
        }
        Err(e) => {
            fmt.Print("refused ")
            fmt.Print(e.Msg)
        }
    }
    fmt.PrintNl()

    // The same writer over a table that holds one pair of each scalar kind, so
    // the writing of each kind stands on a line of its own.
    var scalars = new Map<str, Value>()
    scalars.Insert("whole", Value.Num(7.0))
    scalars.Insert("fraction", Value.Num(-2.5))
    scalars.Insert("big", Value.Num(1.0e30))
    scalars.Insert("yes", Value.Bool(true))
    scalars.Insert("no", Value.Bool(false))
    scalars.Insert("empty", Value.Str(""))
    scalars.Insert("plain", Value.Str("text"))
    var alone = new Buf(0)
    toml.Encode(alone, Value.Obj(scalars))
    printText(alone.Str())
    fmt.PrintNl()
}
