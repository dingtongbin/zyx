package main

import "std/fmt"

struct Big {
    a: i64
    b: i64
}

func make() -> i64 {
    var one = Big { a: 1, b: 2 }
    var two = Big { a: 3, b: 4 }
    var total = 0
    if one.a > 0 {
        total += one.a
    }
    return total + two.b
}

func main() {
    fmt.PrintI64(make())
    fmt.PrintNl()
}
