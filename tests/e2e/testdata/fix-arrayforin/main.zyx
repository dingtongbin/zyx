package main

import "std/fmt"

// A fixed-size array is walked by value. The array is read on every round, so
// the object behind the binding has to stay alive until the walk is over: an
// element read after the object was returned to the region answers whatever
// the region put there next.

const Weights: [i64; 4] = [10, 20, 30, 40]

struct Row {
    cells: [i64; 4]
}

func sum(values: [i64; 4]) -> i64 {
    var total: i64 = 0
    for v in values {
        total += v
    }
    return total
}

func main() {
    var local: [i64; 4] = [1, 2, 3, 4]
    fmt.PrintI64(sum(local))
    fmt.PrintNl()
    var row = Row { cells: [5, 6, 7, 8] }
    var cells: i64 = 0
    for v in row.cells {
        cells += v
    }
    fmt.PrintI64(cells)
    fmt.PrintNl()
    var weights: i64 = 0
    for v in Weights {
        weights += v
    }
    fmt.PrintI64(weights)
    fmt.PrintNl()
}
