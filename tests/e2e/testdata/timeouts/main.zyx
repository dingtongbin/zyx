package main

import "std/fmt"

const Wait: Duration = dur.ms(5)

func waitOrRead(ch: chan<i64>) -> i64 {
    select {
        recv (ch) -> v, ok {
            if ok {
                return v
            }
            return- 1
        }
        timeout (Wait) {
            return- 2
        }
    }
}

func main() {
    var ch = new chan<i64>(1)
    fmt.PrintI64(waitOrRead(ch))
    fmt.PrintNl()
    ch.Send(9)
    fmt.PrintI64(waitOrRead(ch))
    fmt.PrintNl()
}
