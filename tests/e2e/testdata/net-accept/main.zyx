package main

// The accepting side of a listener, over the loopback address only. One
// coroutine dials while another accepts connections in a loop and hands each
// to a handler, which is what the loop is for. The port is chosen by the
// program and never printed, so every line below is the same wherever the
// program runs.

import "std/fmt"
import "std/net"
import "std/time"

// bound is a listener with the address it took.
struct bound {
    listener: net.Listener
    addr: str
}

// listen_first listens on a loopback port that is free, because which port the
// program gets is not part of what it prints.
func listen_first() -> Result<bound, net.Error> {
    var port = 20000 + i32(time.UnixMilli() % 20000)
    var tries: i32 = 0
    for tries < 64 {
        var addr = f"127.0.0.1:{i64(port)}"
        match net.Listen("tcp", addr) {
            Ok(listener) => { return Result.Ok(bound { listener: listener, addr: addr }) }
            Err(_) => { port += 1 }
        }
        tries += 1
    }
    var addr = f"127.0.0.1:{i64(port)}"
    var listener = try net.Listen("tcp", addr)
    return Result.Ok(bound { listener: listener, addr: addr })
}

// dial makes one connection and says one word over it, which is what the
// accepting loop waits for.
func dial(addr: str) {
    match net.Dial("tcp", addr) {
        Ok(conn) => {
            match conn.WriteStr("hello") {
                Ok(_) => { }
                Err(_) => { fmt.Println("the dialer could not write") }
            }
            conn.Close()
        }
        Err(_) => { fmt.Println("the dialer could not connect") }
    }
}

// take reads one word from a connection and answers whether the accepting loop
// goes on. One connection is enough, so it answers no.
func take(conn: net.Conn) -> bool {
    var b = new Buf(0)
    match conn.Read(b, 64) {
        Ok(_) => {
            fmt.Print("accepted: ")
            fmt.Println(b.Str())
        }
        Err(_) => { fmt.Println("accepted: nothing") }
    }
    return false
}

func main() {
    match run() {
        Ok(_) => { }
        Err(e) => {
            var message = f"net accept test: {e.Msg}"
            panic(message)
        }
    }
}

func run() -> Result<(), net.Error> {
    var first = try listen_first()
    var listener = first.listener
    fmt.Println("listening: ok")

    // One coroutine dials while this one accepts in a loop and hands the
    // connection to the handler, which ends the loop.
    region {
        spawn dial(first.addr)
        try listener.AcceptLoop(func take)
    }
    listener.Close()
    fmt.Println("done")
    return Result.Ok()
}
