package main

import "std/fmt"
import "std/math"

// Scalar mathematics, printed value by value so a change of behaviour shows up
// here. The values are finite and exact where the function is, so the output
// is the same wherever it runs.

func main() {
    fmt.PrintF64(math.Sqrt(2.0))
    fmt.PrintNl()
    fmt.PrintF64(math.Sqrt(9.0))
    fmt.PrintNl()
    fmt.PrintF64(math.Abs(- 3.5))
    fmt.PrintNl()

    fmt.PrintF64(math.Sin(0.0))
    fmt.PrintNl()
    fmt.PrintF64(math.Cos(0.0))
    fmt.PrintNl()
    fmt.PrintF64(math.Tan(0.0))
    fmt.PrintNl()
    fmt.PrintF64(math.Asin(1.0))
    fmt.PrintNl()
    fmt.PrintF64(math.Acos(1.0))
    fmt.PrintNl()
    fmt.PrintF64(math.Atan(1.0))
    fmt.PrintNl()
    fmt.PrintF64(math.Atan2(1.0, 1.0))
    fmt.PrintNl()

    fmt.PrintF64(math.Exp(0.0))
    fmt.PrintNl()
    fmt.PrintF64(math.Log(1.0))
    fmt.PrintNl()
    fmt.PrintF64(math.Log2(8.0))
    fmt.PrintNl()
    fmt.PrintF64(math.Log10(1000.0))
    fmt.PrintNl()

    fmt.PrintF64(math.Floor(- 1.5))
    fmt.PrintNl()
    fmt.PrintF64(math.Ceil(- 1.5))
    fmt.PrintNl()
    fmt.PrintF64(math.Round(2.5))
    fmt.PrintNl()
    fmt.PrintF64(math.Round(- 2.5))
    fmt.PrintNl()
    fmt.PrintF64(math.Trunc(- 1.9))
    fmt.PrintNl()

    fmt.PrintF64(math.Pow(2.0, 10.0))
    fmt.PrintNl()
    fmt.PrintF64(math.Hypot(3.0, 4.0))
    fmt.PrintNl()
    fmt.PrintF64(math.Copysign(3.0, - 1.0))
    fmt.PrintNl()

    fmt.PrintF64(math.Min(2.0, 3.0))
    fmt.PrintNl()
    fmt.PrintF64(math.Max(2.0, 3.0))
    fmt.PrintNl()
    fmt.PrintF64(math.Clamp(- 5.0, 0.0, 1.0))
    fmt.PrintNl()
    fmt.PrintF64(math.Clamp(0.5, 0.0, 1.0))
    fmt.PrintNl()
    fmt.PrintF64(math.Clamp(5.0, 0.0, 1.0))
    fmt.PrintNl()

    fmt.PrintBool(math.IsNaN(0.0 / 0.0))
    fmt.PrintNl()
    fmt.PrintBool(math.IsNaN(1.0))
    fmt.PrintNl()
    // IsInf answers the sign question for an infinity the program builds
    // itself. A nan value built the same way passes through IsNaN.
    var inf: f64 = 1.0 / 0.0
    fmt.PrintBool(math.IsInf(inf, 0))
    fmt.PrintNl()
    fmt.PrintBool(math.IsInf(inf, 1))
    fmt.PrintNl()
    fmt.PrintBool(math.IsInf(inf, - 1))
    fmt.PrintNl()
    fmt.PrintBool(math.IsInf(- inf, - 1))
    fmt.PrintNl()
    fmt.PrintBool(math.IsInf(1.0, 0))
    fmt.PrintNl()

    // The constants are comptime values of the package.
    fmt.PrintF64(math.PI)
    fmt.PrintNl()
    fmt.PrintF64(math.E)
    fmt.PrintNl()
    fmt.PrintBool(math.IsInf(math.Inf, 1))
    fmt.PrintNl()
    fmt.PrintBool(math.IsInf(- math.Inf, - 1))
    fmt.PrintNl()
    fmt.PrintBool(math.IsNaN(math.NaN))
    fmt.PrintNl()

    fmt.PrintI64(math.AbsI(- 7))
    fmt.PrintNl()
    fmt.PrintI64(math.AbsI(7))
    fmt.PrintNl()
    fmt.PrintI64(math.MinI(3, 5))
    fmt.PrintNl()
    fmt.PrintI64(math.MaxI(3, 5))
    fmt.PrintNl()
    fmt.PrintI64(math.ClampI(9, 0, 4))
    fmt.PrintNl()
    fmt.PrintI64(math.ClampI(- 1, 0, 4))
    fmt.PrintNl()

    fmt.PrintI64(math.DivEuclid(- 7, 3))
    fmt.PrintNl()
    fmt.PrintI64(math.ModEuclid(- 7, 3))
    fmt.PrintNl()
    fmt.PrintI64(math.DivEuclid(7, 3))
    fmt.PrintNl()
    fmt.PrintI64(math.ModEuclid(7, 3))
    fmt.PrintNl()
    fmt.PrintI64(math.DivEuclid(- 7, - 3))
    fmt.PrintNl()
    fmt.PrintI64(math.ModEuclid(- 7, - 3))
    fmt.PrintNl()
    fmt.PrintI64(math.DivEuclid(7, - 3))
    fmt.PrintNl()
    fmt.PrintI64(math.ModEuclid(7, - 3))
    fmt.PrintNl()
    fmt.PrintI64(math.DivEuclid(- 6, 3))
    fmt.PrintNl()
    fmt.PrintI64(math.ModEuclid(- 6, 3))
    fmt.PrintNl()
}
