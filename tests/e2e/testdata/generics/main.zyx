package main

import "std/fmt"

struct Pair<T> {
	first: T
	second: T

	func First() -> T {
		return self.first
	}

	func Second() -> T {
		return self.second
	}

	func Swap() -> Pair<T> {
		return Pair { first: self.second, second: self.first }
	}
}

func pick<T: Eq>(a: T, b: T, chooseFirst: bool) -> T {
	if chooseFirst {
		return a
	}
	return b
}

func wrap<T: Eq>(v: T) -> Pair<T> {
	return Pair { first: v, second: v }
}

func main() {
	var nums: Pair<i64> = Pair { first: 3, second: 4 }
	fmt.PrintI64(nums.First())
	fmt.PrintNl()
	fmt.PrintI64(nums.Second())
	fmt.PrintNl()

	var swapped = nums.Swap()
	fmt.PrintI64(swapped.First())
	fmt.PrintNl()
	fmt.PrintI64(swapped.Second())
	fmt.PrintNl()

	var nested: Pair<Pair<i64>> = Pair { first: nums, second: swapped }
	fmt.PrintI64(nested.First().First())
	fmt.PrintNl()
	fmt.PrintI64(nested.Second().Second())
	fmt.PrintNl()

	var words: Pair<str> = Pair { first: "hello", second: "world" }
	fmt.Println(words.First())
	fmt.Println(words.Second())

	fmt.PrintI64(pick(7, 2, true))
	fmt.PrintNl()
	fmt.Println(pick("alpha", "beta", false))

	fmt.PrintI64(wrap(9).First())
	fmt.PrintNl()
	fmt.Println(wrap("solo").Second())
}
