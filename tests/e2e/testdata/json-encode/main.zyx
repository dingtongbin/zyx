package main

import "std/fmt"
import "std/json"

// The writing surface of std/json: every value the format has, the escapes a
// text needs, the two layouts, and the values the format cannot write. One line
// per value, and the pretty form on lines of its own.

// line prints a value's text beside its name.
func line(label: str, v: Value) {
    fmt.Print(label)
    fmt.Print(" ")
    fmt.Println(json.EncodeStr(v))
}

// bytes_of prints a text one byte at a time, so a line of the answer holds no
// byte that is not printable.
func bytes_of(s: str) {
    var n = s.Len()
    var i: usize = 0
    for i < n {
        fmt.PrintU64(u64(s[i]))
        fmt.Print(" ")
        i += 1
    }
    fmt.PrintNl()
}

// power builds ten raised to n, which is a value the source cannot write as a
// literal without an exponent form the backend cannot take.
func power(n: usize, up: bool) -> f64 {
    var value = 1.0
    var i: usize = 0
    for i < n {
        if up {
            value = value * 10.0
        } else {
            value = value / 10.0
        }
        i += 1
    }
    return value
}

func main() {
    line("null", Value.Null)
    line("true", Value.Bool(true))
    line("false", Value.Bool(false))

    // A whole number is written without a decimal point; the rest keep their
    // digits.
    line("whole", Value.Num(3.0))
    line("negative", Value.Num(- 12.0))
    line("fraction", Value.Num(1.5))
    line("zero", Value.Num(0.0))
    line("decimal", Value.Num(123.456))

    // A value that is not finite has no text in the format, so it is written
    // as null.
    var big = power(21, true)
    var small = power(7, false)
    line("power-up", Value.Num(big))
    line("power-down", Value.Num(small))
    var inf: f64 = 1.0 / 0.0
    var neg_inf: f64 = - 1.0 / 0.0
    var nan: f64 = 0.0 / 0.0
    line("infinity", Value.Num(inf))
    line("negative-infinity", Value.Num(neg_inf))
    line("not-a-number", Value.Num(nan))

    // Texts: plain, empty, and the bytes the format escapes.
    line("empty-text", Value.Str(""))
    line("text", Value.Str("two words"))
    var escaped = new Buf(0)
    escaped.WriteByte(34)
    escaped.WriteByte(92)
    escaped.WriteByte(10)
    escaped.WriteByte(9)
    escaped.WriteByte(13)
    escaped.WriteByte(8)
    escaped.WriteByte(12)
    escaped.WriteByte(1)
    line("escaped-text", Value.Str(escaped.Str()))

    // A text of the language is bytes, and a byte above ASCII is written as it
    // stands.
    var accented = "\u{e9}"
    fmt.Print("accented ")
    bytes_of(json.EncodeStr(Value.Str(accented)))

    // Arrays: empty, one element, many, and nested.
    var none = new Array<Value>(0)
    line("array-empty", Value.Arr(none))
    var one = new Array<Value>(0)
    one.Push(Value.Num(1.0))
    line("array-one", Value.Arr(one))
    var many = new Array<Value>(0)
    many.Push(Value.Null)
    many.Push(Value.Bool(true))
    many.Push(Value.Str("x"))
    line("array-many", Value.Arr(many))
    var nested = new Array<Value>(0)
    nested.Push(Value.Arr(one))
    nested.Push(Value.Arr(none))
    line("array-nested", Value.Arr(nested))

    // Objects: empty, and members written in the order of their names whatever
    // order they were put in.
    var no_members = new Map<str, Value>()
    line("object-empty", Value.Obj(no_members))
    var members = new Map<str, Value>()
    members.Insert("b", Value.Num(2.0))
    members.Insert("a", Value.Num(1.0))
    members.Insert("c", Value.Str("z"))
    line("object-sorted", Value.Obj(members))

    // The two layouts of one value.
    var inner = new Map<str, Value>()
    inner.Insert("list", Value.Arr(many))
    inner.Insert("flag", Value.Bool(false))
    inner.Insert("nil", Value.Null)
    line("object-nested", Value.Obj(inner))

    var compact = new Buf(0)
    json.Encode(compact, Value.Obj(inner))
    fmt.Println(compact.Str())

    var pretty = new Buf(0)
    json.EncodePretty(pretty, Value.Obj(inner))
    fmt.Print(pretty.Str())
    fmt.PrintNl()

    var pretty_array = new Buf(0)
    json.EncodePretty(pretty_array, Value.Arr(many))
    fmt.Print(pretty_array.Str())
    fmt.PrintNl()

    var pretty_empty = new Buf(0)
    json.EncodePretty(pretty_empty, Value.Arr(none))
    fmt.Println(pretty_empty.Str())

    var pretty_one = new Buf(0)
    json.EncodePretty(pretty_one, Value.Num(1.0))
    fmt.Println(pretty_one.Str())
}
