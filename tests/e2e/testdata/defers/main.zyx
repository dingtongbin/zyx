package main

import "std/fmt"

func note(tag: str) {
	fmt.Println(tag)
}

func work(flag: bool) {
	defer note("first")
	defer note("second")
	if flag {
		fmt.Println("body")
		return
	}
	fmt.Println("fell through")
}

func boom() {
	defer note("unwound")
	panic("bang")
}

func main() {
	work(true)
	work(false)
	region {
		spawn boom()
	}
	fmt.Println("survived")
}
