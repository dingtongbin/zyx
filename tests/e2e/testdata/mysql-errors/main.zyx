package main

// The failures of std/mysql that do not need a server: a data source name that
// does not read, and a connection to a port this program chose and knows is
// closed. The port belongs to the machine and the moment, so it never enters
// what is printed.
//
// The messages of a name this package refused are its own and are the same
// wherever it runs. A connection that was refused is named by the kind alone,
// because the text of the failure carries the address that was tried.

import "std/db"
import "std/fmt"
import "std/mysql"
import "std/net"
import "std/time"

// kind_name names a failure kind, because an f-string writes a primitive type
// or a text and the package's kind is an enumeration of its own.
func kind_name(k: db.ErrorKind) -> str {
    match k {
        NotFound => { return "NotFound" }
        Permission => { return "Permission" }
        Exists => { return "Exists" }
        NotDir => { return "NotDir" }
        IsDir => { return "IsDir" }
        Invalid => { return "Invalid" }
        Closed => { return "Closed" }
        Timeout => { return "Timeout" }
        Interrupted => { return "Interrupted" }
        WouldBlock => { return "WouldBlock" }
        Eof => { return "Eof" }
        AddrInUse => { return "AddrInUse" }
        AddrNotAvailable => { return "AddrNotAvailable" }
        Refused => { return "Refused" }
        Reset => { return "Reset" }
        Unreachable => { return "Unreachable" }
        Other => { return "Other" }
    }
}

// pick_port answers a loopback port that is free at the moment. A port already
// taken is passed over, because which port the program gets is not part of
// what it prints.
func pick_port() -> i32 {
    var port = 20000 + i32(time.UnixMilli() % 20000)
    var tries: i32 = 0
    for tries < 64 {
        match net.Listen("tcp", f"127.0.0.1:{i64(port)}") {
            Ok(listener) => {
                listener.Close()
                return port
            }
            Err(_) => {
                port += 1
            }
        }
        tries += 1
    }
    return port
}

// refused opens the data source name a port names and prints whether the
// connection was refused.
func refused(port: i32) {
    var dsn = f"root:x@tcp(127.0.0.1:{i64(port)})/"
    match mysql.Open(dsn) {
        Ok(conn) => { fmt.Println("refused: opened") }
        Err(e) => { fmt.Println(f"refused: {kind_name(e.Kind)}") }
    }
}

func main() {
    var empty = ""
    match mysql.Open(empty) {
        Ok(conn) => { fmt.Println("empty: opened") }
        Err(e) => { fmt.Println(f"empty: {kind_name(e.Kind)} {e.Msg}") }
    }

    match mysql.Open("garbage") {
        Ok(conn) => { fmt.Println("no database: opened") }
        Err(e) => { fmt.Println(f"no database: {kind_name(e.Kind)} {e.Msg}") }
    }

    match mysql.Open("root:x@udp(127.0.0.1:3306)/db") {
        Ok(conn) => { fmt.Println("bad protocol: opened") }
        Err(e) => { fmt.Println(f"bad protocol: {kind_name(e.Kind)} {e.Msg}") }
    }

    match mysql.Open("root:x@tcp(127.0.0.1:abc)/db") {
        Ok(conn) => { fmt.Println("bad port: opened") }
        Err(e) => { fmt.Println(f"bad port: {kind_name(e.Kind)} {e.Msg}") }
    }

    match mysql.Open("root:x@tcp(127.0.0.1:70000)/db") {
        Ok(conn) => { fmt.Println("big port: opened") }
        Err(e) => { fmt.Println(f"big port: {kind_name(e.Kind)} {e.Msg}") }
    }

    match mysql.Open("root:x@tcp(127.0.0.1/db") {
        Ok(conn) => { fmt.Println("unclosed: opened") }
        Err(e) => { fmt.Println(f"unclosed: {kind_name(e.Kind)} {e.Msg}") }
    }

    // The layer reaches the same refusal through the driver a program passes.
    match db.Open(mysql.Driver(), "garbage") {
        Ok(conn) => { fmt.Println("driver: opened") }
        Err(e) => { fmt.Println(f"driver: {kind_name(e.Kind)} {e.Msg}") }
    }

    refused(pick_port())
}
