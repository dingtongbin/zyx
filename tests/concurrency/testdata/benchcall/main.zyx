package main

import "std/fmt"
import c "stdlib.h"

// One hundred thousand C calls that return at once. A call that may block is
// made where it stands, so this is the cost of the bracket around it and
// nothing else: it is what "zero overhead" has to be measured against.

func sum(n: i64) -> i64 {
    var total: i64 = 0
    for i in 0..n {
        total = total + i64(c.abs(-1))
    }
    return total
}

func main() {
    fmt.PrintI64(sum(100000))
    fmt.PrintNl()
}
