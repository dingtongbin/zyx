package ws

// A WebSocket: the handshake a connection is upgraded with, and the frames that
// travel after it. RFC 6455 fixes both, and the accept a server answers a
// client's key with is the SHA-1 of that key beside one fixed text, which is why
// the hash lives in std/crypto.
//
// The handshake is HTTP, so a client states a URL and a server is handed the
// request the connection arrived with; after that the bytes of the protocol are
// this package's own. A client masks what it sends and a server does not, which is
// the one thing the two sides do differently.

import "std/crypto"
import "std/enc"
import "std/http"
import "std/net"
import "std/rand"

// ErrorKind is what went wrong. Every system package reports failures in this
// shape, so one program reads them the same way wherever they come from.
enum ErrorKind {
    NotFound
    Permission
    Exists
    NotDir
    IsDir
    Invalid
    Closed
    Timeout
    Interrupted
    WouldBlock
    Eof
    AddrInUse
    AddrNotAvailable
    Refused
    Reset
    Unreachable
    Other
}

// Error is one failure of this package.
struct Error {
    Kind: ErrorKind
    Errno: i32
    Msg: str

    impl Show {
        func Show(w: Buf) {
            w.WriteStr(f"ws: {self.Msg}")
        }
    }
}

// The opcodes RFC 6455 fixes: a continuation carries the rest of a message, a
// text or binary frame starts one, and the three control frames travel beside
// them.
const OP_CONT: i32 = 0
const OP_TEXT: i32 = 1
const OP_BINARY: i32 = 2
const OP_CLOSE: i32 = 8
const OP_PING: i32 = 9
const OP_PONG: i32 = 10

// accept_guid is the text RFC 6455 fixes beside a client's key, which the accept
// a server answers with is hashed from.
const accept_guid: str = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

// read_chunk is how many bytes a read asks for at a time.
const read_chunk: usize = 4096

// count answers how many bytes a view holds, which the language gives no method
// for and a walk answers.
func count(b: [u8]) -> usize {
    var n: usize = 0
    for _ in b {
        n += 1
    }
    return n
}

// byte_at answers one byte of a view, so that the value can be read without
// holding the view across a call.
func byte_of(b: [u8], at: usize) -> u8 {
    var i: usize = 0
    for piece in b {
        if i == at {
            return piece
        }
        i += 1
    }
    return u8(0)
}

// accept_of answers the key a server accepts a client's key with: the key, the
// fixed text, and the SHA-1 of the two, in base64.
func accept_of(key: str) -> str {
    var line = new Buf(0)
    line.WriteStr(key)
    line.WriteStr(accept_guid)
    var digest = crypto.Sha1Sum(line.Bytes())
    var out = new Buf(0)
    enc.Encode(out, digest[0..digest.Len()])
    return out.Str()
}

// key_of answers a new key for a client to offer: sixteen random bytes, in
// base64, which is what RFC 6455 asks for.
func key_of() -> str {
    var bytes = new Buf(0)
    var engine = new rand.Rng(rand.SeedFromTime())
    var i: usize = 0
    for i < 16 {
        bytes.WriteByte(u8(engine.Next() & u64(0xFF)))
        i += 1
    }
    var out = new Buf(0)
    enc.Encode(out, bytes.Bytes())
    return out.Str()
}

// A target is the authority and the path a ws URL names.
struct target {
    authority: str
    path: str
}

// split_url reads the URL a client was given. The scheme is ws; the authority is
// what a connection is made to, and the path is what the request asks for.
func split_url(url: str) -> Result<target, Error> {
    var text = url
    if text.Len() > 5 && text[0..5] == "ws://" {
        text = text[5..text.Len()]
    } else {
        return Result.Err(Error { Kind: ErrorKind.Invalid, Errno: 0, Msg: "the URL does not begin with ws://" })
    }
    var at: usize = 0
    for at < text.Len() && u32(text[at]) != u32('/') {
        at += 1
    }
    var authority = text[0..at]
    var path = "/"
    if at < text.Len() {
        path = text[at..text.Len()]
    }
    if authority.Len() == 0 {
        return Result.Err(Error { Kind: ErrorKind.Invalid, Errno: 0, Msg: "the URL names no host" })
    }
    return Result.Ok(target { authority: authority, path: path })
}

// A Socket is one upgraded connection. It carries the bytes that have arrived and
// not been read yet, because a frame may end in the middle of a read and the next
// one may begin right after it.
struct Socket {
    conn: net.Conn
    pending: Buf
    mask: bool
    closed: bool

    impl SyncSafe { }

    // more reads what the connection has to offer and answers how many bytes
    // arrived, or zero when the far end is done.
    func more() -> usize {
        var chunk = new Buf(0)
        match self.conn.Read(chunk, read_chunk) {
            Ok(n) => {
                if n == 0 {
                    return 0
                }
                self.pending.Write(chunk.Bytes())
                return n
            }
            Err(_) => { return 0 }
        }
    }

    // exact answers the next n bytes, waiting for them if they have not arrived.
    func exact(n: usize) -> Result<str, Error> {
        for self.pending.Len() < n {
            if self.more() == 0 {
                return Result.Err(Error { Kind: ErrorKind.Eof, Errno: 0, Msg: "the connection ended in a frame" })
            }
        }
        var text = self.pending.Str()
        var out = text[0..n]
        var whole = self.pending.Bytes()
        var rest = new Buf(0)
        var at: usize = n
        var size = count(whole)
        for at < size {
            rest.WriteByte(byte_of(whole, at))
            at += 1
        }
        self.pending = rest
        return Result.Ok(out)
    }

    // line answers the next line of the handshake, without its carriage return
    // and line feed.
    func line() -> Result<str, Error> {
        for {
            var text = self.pending.Str()
            var at: usize = 0
            for at + 1 < text.Len() {
                if u32(text[at]) == u32('\r') && u32(text[at + 1]) == u32('\n') {
                    var out = text[0..at]
                    var whole = self.pending.Bytes()
                    var rest = new Buf(0)
                    var i = at + 2
                    var size = count(whole)
                    for i < size {
                        rest.WriteByte(byte_of(whole, i))
                        i += 1
                    }
                    self.pending = rest
                    return Result.Ok(out)
                }
                at += 1
            }
            if self.more() == 0 {
                return Result.Err(Error { Kind: ErrorKind.Eof, Errno: 0, Msg: "the handshake ended early" })
            }
        }
        return Result.Err(Error { Kind: ErrorKind.Eof, Errno: 0, Msg: "the handshake ended early" })
    }

    // frame writes one frame, masked when this side is the client.
    func frame(opcode: i32, payload: [u8]) -> Result<(), Error> {
        if self.closed {
            return Result.Err(Error { Kind: ErrorKind.Closed, Errno: 0, Msg: "the socket is closed" })
        }
        var n = count(payload)
        var out = new Buf(0)
        out.WriteByte(u8(0x80 | u32(opcode)))
        var masked = self.mask
        var flag: u32 = 0
        if masked {
            flag = 0x80
        }
        if n <= 125 {
            out.WriteByte(u8(flag | u32(n)))
        } else if n <= 65535 {
            out.WriteByte(u8(flag | 126))
            out.WriteByte(u8(u32(n) >> u32(8)))
            out.WriteByte(u8(u32(n)))
        } else {
            out.WriteByte(u8(flag | 127))
            var i: usize = 0
            for i < 8 {
                out.WriteByte(u8(u64(n) >> u64((7 - i) * 8)))
                i += 1
            }
        }
        if masked {
            var engine = new rand.Rng(rand.SeedFromTime())
            var key = new Array<u8>(0)
            var k: usize = 0
            for k < 4 {
                key.Push(u8(engine.Next() & u64(0xFF)))
                k += 1
            }
            for b in key {
                out.WriteByte(b)
            }
            var at: usize = 0
            for at < n {
                out.WriteByte(byte_of(payload, at) ^ key[at % 4])
                at += 1
            }
        } else {
            out.Write(payload)
        }
        match self.conn.WriteAll(out.Bytes()) {
            Ok(_) => { return Result.Ok() }
            Err(_) => { return Result.Err(Error { Kind: ErrorKind.Reset, Errno: 0, Msg: "the frame could not be written" }) }
        }
    }

    // Send writes one frame with the opcode it is given: 1 text, 2 binary, 8
    // close, 9 ping, or 10 pong.
    func Send(opcode: i32, payload: [u8]) -> Result<(), Error> {
        return self.frame(opcode, payload)
    }

    // SendStr writes a text frame.
    func SendStr(s: str) -> Result<(), Error> {
        var out = new Buf(0)
        out.WriteStr(s)
        return self.frame(OP_TEXT, out.Bytes())
    }

    // Recv reads one whole message and appends its payload to b, answering the
    // opcode of the message and how many bytes it carried. A message that arrives
    // in pieces is put together here, a ping is answered with a pong, and a close
    // is answered with a close and handed to the caller as a close. A message
    // longer than max is refused.
    func Recv(b: Buf, max: usize) -> Result<(i32, usize), Error> {
        if self.closed {
            return Result.Err(Error { Kind: ErrorKind.Closed, Errno: 0, Msg: "the socket is closed" })
        }
        var opcode: i32 = -1
        var total: usize = 0
        for {
            var head = try self.exact(2)
            var b0 = u32(head[0])
            var b1 = u32(head[1])
            var last = (b0 & 0x80) != 0
            var op = i32(b0 & 0x0F)
            var masked = (b1 & 0x80) != 0
            var length = usize(b1 & 0x7F)
            if length == 126 {
                var wide = try self.exact(2)
                length = (usize(wide[0]) << usize(8)) | usize(wide[1])
            } else if length == 127 {
                var wide = try self.exact(8)
                var value: usize = 0
                var i: usize = 0
                for i < 8 {
                    value = (value << usize(8)) | usize(wide[i])
                    i += 1
                }
                length = value
            }
            var key: str = ""
            if masked {
                key = try self.exact(4)
            }
            var payload = new Buf(0)
            if length > 0 {
                var bytes = try self.exact(length)
                var i: usize = 0
                for i < length {
                    var one = u32(bytes[i])
                    if masked {
                        one = one ^ u32(key[i % 4])
                    }
                    payload.WriteByte(u8(one))
                    i += 1
                }
            }
            if op == OP_PING {
                // A ping is answered where it arrives, with what it carried.
                match self.frame(OP_PONG, payload.Bytes()) {
                    Ok(_) => { }
                    Err(_) => { }
                }
                continue
            }
            if op == OP_PONG {
                continue
            }
            if op == OP_CLOSE {
                match self.frame(OP_CLOSE, payload.Bytes()) {
                    Ok(_) => { }
                    Err(_) => { }
                }
                self.closed = true
                return Result.Ok((OP_CLOSE, payload.Len()))
            }
            if op == OP_CONT {
                if opcode < 0 {
                    return Result.Err(Error { Kind: ErrorKind.Invalid, Errno: 0, Msg: "a continuation arrived with nothing to continue" })
                }
            } else {
                if opcode >= 0 {
                    return Result.Err(Error { Kind: ErrorKind.Invalid, Errno: 0, Msg: "a message began before the last one ended" })
                }
                opcode = op
            }
            if total + payload.Len() > max {
                return Result.Err(Error { Kind: ErrorKind.Invalid, Errno: 0, Msg: "the message is longer than the caller takes" })
            }
            b.Write(payload.Bytes())
            total += payload.Len()
            if last {
                if opcode != OP_TEXT && opcode != OP_BINARY {
                    return Result.Err(Error { Kind: ErrorKind.Invalid, Errno: 0, Msg: "a message carried an unknown opcode" })
                }
                return Result.Ok((opcode, total))
            }
        }
        return Result.Err(Error { Kind: ErrorKind.Invalid, Errno: 0, Msg: "the message did not end" })
    }

    // Close sends a close frame with the code and reason it is given, and gives
    // the connection up. It is idempotent.
    func Close(code: i32, reason: str) -> Result<(), Error> {
        if self.closed {
            return Result.Ok()
        }
        var out = new Buf(0)
        out.WriteByte(u8(u32(code) >> u32(8)))
        out.WriteByte(u8(u32(code)))
        out.WriteStr(reason)
        match self.frame(OP_CLOSE, out.Bytes()) {
            Ok(_) => { }
            Err(_) => { }
        }
        self.closed = true
        self.conn.Close()
        return Result.Ok()
    }
}

// Dial connects to the server a ws URL names and upgrades the connection. The URL
// is ws://host:port/path; a wss:// URL would go through std/tls, which this
// package does not reach.
func Dial(url: str) -> Result<Socket, Error> {
    var where = try split_url(url)
    match net.Dial("tcp", where.authority) {
        Ok(conn) => { return greet(conn, where) }
        Err(_) => {
            return Result.Err(Error { Kind: ErrorKind.Refused, Errno: 0, Msg: "the server could not be reached" })
        }
    }
}

// greet offers the handshake over a fresh connection and reads the answer, which
// carries the accept the key it offered decides.
func greet(conn: net.Conn, where: target) -> Result<Socket, Error> {
    var socket = Socket { conn: conn, pending: new Buf(0), mask: true, closed: false }
    var key = key_of()
    var request = new Buf(0)
    request.WriteStr(f"GET {where.path} HTTP/1.1\r\n")
    request.WriteStr(f"Host: {where.authority}\r\n")
    request.WriteStr("Upgrade: websocket\r\n")
    request.WriteStr("Connection: Upgrade\r\n")
    request.WriteStr(f"Sec-WebSocket-Key: {key}\r\n")
    request.WriteStr("Sec-WebSocket-Version: 13\r\n")
    request.WriteStr("\r\n")
    match conn.WriteAll(request.Bytes()) {
        Ok(_) => { }
        Err(_) => {
            conn.Close()
            return Result.Err(Error { Kind: ErrorKind.Reset, Errno: 0, Msg: "the handshake could not be sent" })
        }
    }
    match read_handshake(socket) {
        Ok(greeting) => {
            if greeting.status != 101 {
                conn.Close()
                return Result.Err(Error { Kind: ErrorKind.Invalid, Errno: 0, Msg: "the server did not switch protocols" })
            }
            if greeting.accept != accept_of(key) {
                conn.Close()
                return Result.Err(Error { Kind: ErrorKind.Invalid, Errno: 0, Msg: "the server accepted a key this client did not offer" })
            }
            return Result.Ok(socket)
        }
        Err(e) => {
            conn.Close()
            return Result.Err(e)
        }
    }
}

// answer is what the server's half of a handshake carries.
struct answer {
    status: i32
    accept: str
}

// read_handshake reads the status line and the fields of a handshake answer, and
// leaves the bytes after them where the frames that follow are read from.
func read_handshake(socket: Socket) -> Result<answer, Error> {
    var status = try socket.line()
    if status.Len() < 12 {
        return Result.Err(Error { Kind: ErrorKind.Invalid, Errno: 0, Msg: "the answer is not a status line" })
    }
    var number = try decimal(status[9..12])
    var accept = ""
    for {
        var field = try socket.line()
        if field.Len() == 0 {
            break
        }
        var colon: usize = 0
        for colon < field.Len() && u32(field[colon]) != u32(':') {
            colon += 1
        }
        if colon + 1 >= field.Len() {
            continue
        }
        var name = field[0..colon]
        var value = trim(field[colon + 1..field.Len()])
        if same_name(name, "sec-websocket-accept") {
            accept = value
        }
    }
    return Result.Ok(answer { status: number, accept: accept })
}

// decimal reads a whole number written in decimal.
func decimal(text: str) -> Result<i32, Error> {
    var value: i32 = 0
    var at: usize = 0
    for at < text.Len() {
        var ch = u32(text[at])
        if ch < u32('0') || ch > u32('9') {
            return Result.Err(Error { Kind: ErrorKind.Invalid, Errno: 0, Msg: "a number was expected" })
        }
        value = value * 10 + i32(ch - u32('0'))
        at += 1
    }
    return Result.Ok(value)
}

// trim answers the text without the spaces and tabs around it.
func trim(text: str) -> str {
    var lo: usize = 0
    var hi = text.Len()
    for lo < hi && is_space(text[lo]) {
        lo += 1
    }
    for hi > lo && is_space(text[hi - 1]) {
        hi -= 1
    }
    return text[lo..hi]
}

// is_space answers whether a byte is one of the two a field value may be padded
// with.
func is_space(b: u8) -> bool {
    return u32(b) == u32(' ') || u32(b) == u32('\t')
}

// same_name compares two field names without their case, which is how HTTP reads
// them.
func same_name(a: str, b: str) -> bool {
    if a.Len() != b.Len() {
        return false
    }
    var at: usize = 0
    for at < a.Len() {
        if lower(a[at]) != lower(b[at]) {
            return false
        }
        at += 1
    }
    return true
}

// lower answers the ASCII lower case of a byte.
func lower(b: u8) -> u8 {
    var value = u32(b)
    if value >= u32('A') && value <= u32('Z') {
        return u8(value + 32)
    }
    return b
}

// Upgrade answers the handshake a server makes over a connection whose request
// asked for one. The connection is this socket's from then on, so the caller must
// not read or write it again, and the request's key decides the accept the answer
// carries.
func Upgrade(conn: net.Conn, req: http.Request) -> Result<Socket, Error> {
    var key = req.Header.Get("Sec-WebSocket-Key").UnwrapOr("")
    if key.Len() == 0 {
        return Result.Err(Error { Kind: ErrorKind.Invalid, Errno: 0, Msg: "the request offers no key" })
    }
    if !same_name(req.Header.Get("Upgrade").UnwrapOr(""), "websocket") {
        return Result.Err(Error { Kind: ErrorKind.Invalid, Errno: 0, Msg: "the request does not ask for a websocket" })
    }
    var socket = Socket { conn: conn, pending: new Buf(0), mask: false, closed: false }
    var out = new Buf(0)
    out.WriteStr("HTTP/1.1 101 Switching Protocols\r\n")
    out.WriteStr("Upgrade: websocket\r\n")
    out.WriteStr("Connection: Upgrade\r\n")
    out.WriteStr(f"Sec-WebSocket-Accept: {accept_of(key)}\r\n")
    out.WriteStr("\r\n")
    match conn.WriteAll(out.Bytes()) {
        Ok(_) => { return Result.Ok(socket) }
        Err(_) => {
            return Result.Err(Error { Kind: ErrorKind.Reset, Errno: 0, Msg: "the answer could not be sent" })
        }
    }
}
