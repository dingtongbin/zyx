package crypto

// Hashing with the SHA-2 family and HMAC, in the language itself. The padding,
// the round constants and the initial state are the ones FIPS 180-4 fixes, and
// the words of a message are read big-endian, so a digest comes out the same
// wherever it is computed.
//
// A hasher is a streaming reference type: bytes go in through Write and the
// digest of everything written so far comes out of Sum, which leaves the
// running state alone. A comparison of two digests goes through Equal, whose
// cost does not depend on where they first differ.

// SHA256_SIZE is the length of a SHA-256 digest in bytes.
const SHA256_SIZE = 32

// SHA512_SIZE is the length of a SHA-512 digest in bytes.
const SHA512_SIZE = 64

// The block both hashers compress. A message is padded to a whole number of
// them, and an HMAC key is padded to the SHA-256 one.
const sha256_block: usize = 64
const sha512_block: usize = 128

// length counts the bytes of a view. A slice carries its length, but the
// language gives no method for it, so the count is taken by walking once.
func length(src: [u8]) -> usize {
    var n: usize = 0
    for _ in src {
        n += 1
    }
    return n
}

// Equal reports whether two byte strings are the same length and the same
// bytes. It reads every byte of both whatever it has seen so far, so the time
// it takes depends on the length alone; two digests are compared with it and
// never with ==.
func Equal(a: [u8], b: [u8]) -> bool {
    var n = length(a)
    if length(b) != n {
        return false
    }
    var diff: u8 = 0
    for i in 0 .. n {
        diff |= a[i] ^ b[i]
    }
    return diff == 0
}

// Sha256Sum answers the SHA-256 digest of b.
func Sha256Sum(b: [u8]) -> Array<u8> {
    var h = new Sha256()
    h.Write(b)
    return h.Sum()
}

// Sha512Sum answers the SHA-512 digest of b.
func Sha512Sum(b: [u8]) -> Array<u8> {
    var h = new Sha512()
    h.Write(b)
    return h.Sum()
}

// SHA1_SIZE is the length of a SHA-1 digest in bytes.
const SHA1_SIZE: usize = 20

// sha1_block is the block SHA-1 compresses, which RFC 3174 fixes with the rest of
// the hash.
const sha1_block: usize = 64

// Sha1Sum answers the SHA-1 digest of b. The handshake a WebSocket opens with
// fixes this hash (RFC 6455), which is what the standard library needs it for:
// it is not a hash to build anything new on.
func Sha1Sum(b: [u8]) -> Array<u8> {
    var state = sha1_initial()
    var n = length(b)
    var at: usize = 0
    for at + sha1_block <= n {
        sha1_compress(state, b[at .. at + sha1_block])
        at += sha1_block
    }
    var tail = new Array<u8>(0)
    var i = at
    for i < n {
        tail.Push(b[i])
        i += 1
    }
    tail.Push(u8(0x80))
    for tail.Len() % sha1_block != 56 {
        tail.Push(u8(0))
    }
    var bits = u64(n) << u64(3)
    for i in 0 .. 8 {
        var shift = u64((7 - i) * 8)
        tail.Push(u8(bits >> shift))
    }
    var j: usize = 0
    for j < tail.Len() {
        sha1_compress(state, tail[j .. j + sha1_block])
        j += sha1_block
    }
    var out = new Array<u8>(0)
    for i in 0 .. state.Len() {
        var v = state[i]
        out.Push(u8(v >> u32(24)))
        out.Push(u8(v >> u32(16)))
        out.Push(u8(v >> u32(8)))
        out.Push(u8(v))
    }
    return out
}

// sha1_initial is the five working words SHA-1 starts from, which RFC 3174 fixes.
func sha1_initial() -> Array<u32> {
    var out = new Array<u32>(5)
    out.Push(u32(0x67452301))
    out.Push(u32(0xEFCDAB89))
    out.Push(u32(0x98BADCFE))
    out.Push(u32(0x10325476))
    out.Push(u32(0xC3D2E1F0))
    return out
}

// sha1_compress folds one 64-byte block into the five working words. The schedule
// is the sixteen words of the block and then sixty-four more, each the exclusive
// or of four earlier ones turned left by one, and the eighty rounds are the four
// functions and four constants RFC 3174 fixes.
func sha1_compress(state: Array<u32>, block: [u8]) {
    var w = new Array<u32>(0)
    var i: usize = 0
    for i < 16 {
        var at = i * 4
        var word = u32(block[at]) << u32(24)
        word |= u32(block[at + 1]) << u32(16)
        word |= u32(block[at + 2]) << u32(8)
        word |= u32(block[at + 3])
        w.Push(word)
        i += 1
    }
    for i < 80 {
        var rolled = (w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16]).rotr(u32(31))
        w.Push(rolled)
        i += 1
    }
    var wa = state[0]
    var wb = state[1]
    var wc = state[2]
    var wd = state[3]
    var we = state[4]
    i = 0
    for i < 80 {
        var f = u32(0)
        var k = u32(0)
        if i < 20 {
            f = (wb & wc) | ((~wb) & wd)
            k = u32(0x5A827999)
        } else if i < 40 {
            f = wb ^ wc ^ wd
            k = u32(0x6ED9EBA1)
        } else if i < 60 {
            f = (wb & wc) | (wb & wd) | (wc & wd)
            k = u32(0x8F1BBCDC)
        } else {
            f = wb ^ wc ^ wd
            k = u32(0xCA62C1D6)
        }
        var temp = wa.rotr(u32(27)).wrap_add(f).wrap_add(we).wrap_add(k).wrap_add(w[i])
        we = wd
        wd = wc
        wc = wb.rotr(u32(2))
        wb = wa
        wa = temp
        i += 1
    }
    var n0 = state[0].wrap_add(wa)
    var n1 = state[1].wrap_add(wb)
    var n2 = state[2].wrap_add(wc)
    var n3 = state[3].wrap_add(wd)
    var n4 = state[4].wrap_add(we)
    state[0] = n0
    state[1] = n1
    state[2] = n2
    state[3] = n3
    state[4] = n4
}

// HmacSha256 answers the HMAC-SHA256 of msg under key, in the construction RFC
// 2104 fixes: a key longer than one block is hashed first, the key is padded to
// the block, and the two pads are mixed in around the message.
func HmacSha256(key: [u8], msg: [u8]) -> Array<u8> {
    var padded = new Array<u8>(0)
    if length(key) > sha256_block {
        for b in Sha256Sum(key) {
            padded.Push(b)
        }
    } else {
        for b in key {
            padded.Push(b)
        }
    }
    for padded.Len() < sha256_block {
        padded.Push(u8(0))
    }

    var inner = new Sha256()
    var ipad = new Array<u8>(0)
    for i in 0 .. sha256_block {
        ipad.Push(padded[i] ^ u8(0x36))
    }
    inner.Write(ipad[0..ipad.Len()])
    inner.Write(msg)
    var digest = inner.Sum()

    var outer = new Sha256()
    var opad = new Array<u8>(0)
    for i in 0 .. sha256_block {
        opad.Push(padded[i] ^ u8(0x5c))
    }
    outer.Write(opad[0..opad.Len()])
    outer.Write(digest[0..digest.Len()])
    return outer.Sum()
}

// A Sha256 is a streaming SHA-256 digest. Its state is the eight working words
// and its block holds the bytes that have not filled one yet.
struct Sha256 {
    state: Array<u32>
    round: Array<u32>
    block: Array<u8>
    used: usize
    total: u64

    // init builds a hasher in its starting state.
    func init() -> Self {
        var block = new Array<u8>(0)
        for _ in 0 .. sha256_block {
            block.Push(u8(0))
        }
        return Sha256 { state: sha256_initial(), round: sha256_round(), block: block, used: 0, total: 0 }
    }

    // Reset returns the hasher to its starting state, dropping every byte
    // written so far.
    func Reset() {
        var fresh = sha256_initial()
        for i in 0 .. fresh.Len() {
            self.state[i] = fresh[i]
        }
        self.used = 0
        self.total = 0
    }

    // Write adds bytes to the digest.
    func Write(b: [u8]) {
        var n = length(b)
        self.total += u64(n)
        var i: usize = 0
        for i < n {
            self.block[self.used] = b[i]
            self.used += 1
            if self.used == sha256_block {
                self.compress(self.state, self.block[0..sha256_block])
                self.used = 0
            }
            i += 1
        }
    }

    // Sum answers the digest of everything written so far. It leaves the state
    // where it was, so a caller can keep writing and ask again later.
    func Sum() -> Array<u8> {
        var scratch = new Array<u32>(0)
        for i in 0 .. self.state.Len() {
            scratch.Push(self.state[i])
        }
        self.finish(scratch)
        var out = new Array<u8>(0)
        for i in 0 .. scratch.Len() {
            var v = scratch[i]
            out.Push(u8(v >> u32(24)))
            out.Push(u8(v >> u32(16)))
            out.Push(u8(v >> u32(8)))
            out.Push(u8(v))
        }
        return out
    }

    // finish pads the message and folds it into state. The padding is a one
    // bit, then zeros up to the point where the eight-byte length fits in the
    // last block, then that length in bits, big-endian.
    func finish(state: Array<u32>) {
        var tail = new Array<u8>(0)
        for i in 0 .. self.used {
            tail.Push(self.block[i])
        }
        tail.Push(u8(0x80))
        for tail.Len() % sha256_block != 56 {
            tail.Push(u8(0))
        }
        var bits = self.total << u64(3)
        for i in 0 .. 8 {
            var shift = (7 - i) * 8
            tail.Push(u8(bits >> u64(shift)))
        }
        var at: usize = 0
        for at < tail.Len() {
            self.compress(state, tail[at..at + sha256_block])
            at += sha256_block
        }
    }

    // compress folds one block into state: it expands the sixteen words of the
    // block into sixty-four and runs the sixty-four rounds of the standard.
    func compress(state: Array<u32>, block: [u8]) {
        var w = new Array<u32>(0)
        var i: usize = 0
        for i < 16 {
            var at = i * 4
            var word = u32(block[at]) << u32(24)
            word |= u32(block[at + 1]) << u32(16)
            word |= u32(block[at + 2]) << u32(8)
            word |= u32(block[at + 3])
            w.Push(word)
            i += 1
        }
        for i < 64 {
            var s0 = w[i - 15].rotr(u32(7)) ^ w[i - 15].rotr(u32(18)) ^ (w[i - 15] >> u32(3))
            var s1 = w[i - 2].rotr(u32(17)) ^ w[i - 2].rotr(u32(19)) ^ (w[i - 2] >> u32(10))
            w.Push(w[i - 16].wrap_add(s0).wrap_add(w[i - 7]).wrap_add(s1))
            i += 1
        }
        var wa = state[0]
        var wb = state[1]
        var wc = state[2]
        var wd = state[3]
        var we = state[4]
        var wf = state[5]
        var wg = state[6]
        var wh = state[7]
        i = 0
        for i < 64 {
            var t1 = wh.wrap_add(we.rotr(u32(6)) ^ we.rotr(u32(11)) ^ we.rotr(u32(25)))
            t1 = t1.wrap_add((we & wf) ^ ((~we) & wg))
            t1 = t1.wrap_add(self.round[i]).wrap_add(w[i])
            var t2 = (wa.rotr(u32(2)) ^ wa.rotr(u32(13)) ^ wa.rotr(u32(22))).wrap_add((wa & wb) ^ (wa & wc) ^ (wb & wc))
            wh = wg
            wg = wf
            wf = we
            we = wd.wrap_add(t1)
            wd = wc
            wc = wb
            wb = wa
            wa = t1.wrap_add(t2)
            i += 1
        }
        var h0 = state[0].wrap_add(wa)
        var h1 = state[1].wrap_add(wb)
        var h2 = state[2].wrap_add(wc)
        var h3 = state[3].wrap_add(wd)
        var h4 = state[4].wrap_add(we)
        var h5 = state[5].wrap_add(wf)
        var h6 = state[6].wrap_add(wg)
        var h7 = state[7].wrap_add(wh)
        state[0] = h0
        state[1] = h1
        state[2] = h2
        state[3] = h3
        state[4] = h4
        state[5] = h5
        state[6] = h6
        state[7] = h7
    }
}

// A Sha512 is a streaming SHA-512 digest, built the same way as a Sha256 over
// wider words and a wider block.
struct Sha512 {
    state: Array<u64>
    round: Array<u64>
    block: Array<u8>
    used: usize
    total: u64

    // init builds a hasher in its starting state.
    func init() -> Self {
        var block = new Array<u8>(0)
        for _ in 0 .. sha512_block {
            block.Push(u8(0))
        }
        return Sha512 { state: sha512_initial(), round: sha512_round(), block: block, used: 0, total: 0 }
    }

    // Reset returns the hasher to its starting state, dropping every byte
    // written so far.
    func Reset() {
        var fresh = sha512_initial()
        for i in 0 .. fresh.Len() {
            self.state[i] = fresh[i]
        }
        self.used = 0
        self.total = 0
    }

    // Write adds bytes to the digest.
    func Write(b: [u8]) {
        var n = length(b)
        self.total += u64(n)
        var i: usize = 0
        for i < n {
            self.block[self.used] = b[i]
            self.used += 1
            if self.used == sha512_block {
                self.compress(self.state, self.block[0..sha512_block])
                self.used = 0
            }
            i += 1
        }
    }

    // Sum answers the digest of everything written so far. It leaves the state
    // where it was, so a caller can keep writing and ask again later.
    func Sum() -> Array<u8> {
        var scratch = new Array<u64>(0)
        for i in 0 .. self.state.Len() {
            scratch.Push(self.state[i])
        }
        self.finish(scratch)
        var out = new Array<u8>(0)
        for i in 0 .. scratch.Len() {
            var v = scratch[i]
            out.Push(u8(v >> u64(56)))
            out.Push(u8(v >> u64(48)))
            out.Push(u8(v >> u64(40)))
            out.Push(u8(v >> u64(32)))
            out.Push(u8(v >> u64(24)))
            out.Push(u8(v >> u64(16)))
            out.Push(u8(v >> u64(8)))
            out.Push(u8(v))
        }
        return out
    }

    // finish pads the message and folds it into state. The length field is
    // twice the width of a word here, so sixteen bytes carry it.
    func finish(state: Array<u64>) {
        var tail = new Array<u8>(0)
        for i in 0 .. self.used {
            tail.Push(self.block[i])
        }
        tail.Push(u8(0x80))
        for tail.Len() % sha512_block != 112 {
            tail.Push(u8(0))
        }
        var high = self.total >> u64(61)
        var low = self.total << u64(3)
        for i in 0 .. 8 {
            var shift = (7 - i) * 8
            tail.Push(u8(high >> u64(shift)))
        }
        for i in 0 .. 8 {
            var shift = (7 - i) * 8
            tail.Push(u8(low >> u64(shift)))
        }
        var at: usize = 0
        for at < tail.Len() {
            self.compress(state, tail[at..at + sha512_block])
            at += sha512_block
        }
    }

    // compress folds one block into state: sixteen words expand into eighty,
    // and eighty rounds run over them.
    func compress(state: Array<u64>, block: [u8]) {
        var w = new Array<u64>(0)
        var i: usize = 0
        for i < 16 {
            var at = i * 8
            var word = u64(block[at]) << u64(56)
            word |= u64(block[at + 1]) << u64(48)
            word |= u64(block[at + 2]) << u64(40)
            word |= u64(block[at + 3]) << u64(32)
            word |= u64(block[at + 4]) << u64(24)
            word |= u64(block[at + 5]) << u64(16)
            word |= u64(block[at + 6]) << u64(8)
            word |= u64(block[at + 7])
            w.Push(word)
            i += 1
        }
        for i < 80 {
            var s0 = w[i - 15].rotr(u64(1)) ^ w[i - 15].rotr(u64(8)) ^ (w[i - 15] >> u64(7))
            var s1 = w[i - 2].rotr(u64(19)) ^ w[i - 2].rotr(u64(61)) ^ (w[i - 2] >> u64(6))
            w.Push(w[i - 16].wrap_add(s0).wrap_add(w[i - 7]).wrap_add(s1))
            i += 1
        }
        var wa = state[0]
        var wb = state[1]
        var wc = state[2]
        var wd = state[3]
        var we = state[4]
        var wf = state[5]
        var wg = state[6]
        var wh = state[7]
        i = 0
        for i < 80 {
            var t1 = wh.wrap_add(we.rotr(u64(14)) ^ we.rotr(u64(18)) ^ we.rotr(u64(41)))
            t1 = t1.wrap_add((we & wf) ^ ((~we) & wg))
            t1 = t1.wrap_add(self.round[i]).wrap_add(w[i])
            var t2 = (wa.rotr(u64(28)) ^ wa.rotr(u64(34)) ^ wa.rotr(u64(39))).wrap_add((wa & wb) ^ (wa & wc) ^ (wb & wc))
            wh = wg
            wg = wf
            wf = we
            we = wd.wrap_add(t1)
            wd = wc
            wc = wb
            wb = wa
            wa = t1.wrap_add(t2)
            i += 1
        }
        var h0 = state[0].wrap_add(wa)
        var h1 = state[1].wrap_add(wb)
        var h2 = state[2].wrap_add(wc)
        var h3 = state[3].wrap_add(wd)
        var h4 = state[4].wrap_add(we)
        var h5 = state[5].wrap_add(wf)
        var h6 = state[6].wrap_add(wg)
        var h7 = state[7].wrap_add(wh)
        state[0] = h0
        state[1] = h1
        state[2] = h2
        state[3] = h3
        state[4] = h4
        state[5] = h5
        state[6] = h6
        state[7] = h7
    }
}

// sha256_initial is the starting state of SHA-256: the first thirty-two bits
// of the fractional parts of the square roots of the first eight primes.
func sha256_initial() -> Array<u32> {
    var state = new Array<u32>(0)
    state.Push(u32(0x6a09e667))
    state.Push(u32(0xbb67ae85))
    state.Push(u32(0x3c6ef372))
    state.Push(u32(0xa54ff53a))
    state.Push(u32(0x510e527f))
    state.Push(u32(0x9b05688c))
    state.Push(u32(0x1f83d9ab))
    state.Push(u32(0x5be0cd19))
    return state
}

// sha256_round is the sixty-four round constants of SHA-256: the first
// thirty-two bits of the fractional parts of the cube roots of the first
// sixty-four primes.
func sha256_round() -> Array<u32> {
    var k = new Array<u32>(0)
    k.Push(u32(0x428a2f98))
    k.Push(u32(0x71374491))
    k.Push(u32(0xb5c0fbcf))
    k.Push(u32(0xe9b5dba5))
    k.Push(u32(0x3956c25b))
    k.Push(u32(0x59f111f1))
    k.Push(u32(0x923f82a4))
    k.Push(u32(0xab1c5ed5))
    k.Push(u32(0xd807aa98))
    k.Push(u32(0x12835b01))
    k.Push(u32(0x243185be))
    k.Push(u32(0x550c7dc3))
    k.Push(u32(0x72be5d74))
    k.Push(u32(0x80deb1fe))
    k.Push(u32(0x9bdc06a7))
    k.Push(u32(0xc19bf174))
    k.Push(u32(0xe49b69c1))
    k.Push(u32(0xefbe4786))
    k.Push(u32(0x0fc19dc6))
    k.Push(u32(0x240ca1cc))
    k.Push(u32(0x2de92c6f))
    k.Push(u32(0x4a7484aa))
    k.Push(u32(0x5cb0a9dc))
    k.Push(u32(0x76f988da))
    k.Push(u32(0x983e5152))
    k.Push(u32(0xa831c66d))
    k.Push(u32(0xb00327c8))
    k.Push(u32(0xbf597fc7))
    k.Push(u32(0xc6e00bf3))
    k.Push(u32(0xd5a79147))
    k.Push(u32(0x06ca6351))
    k.Push(u32(0x14292967))
    k.Push(u32(0x27b70a85))
    k.Push(u32(0x2e1b2138))
    k.Push(u32(0x4d2c6dfc))
    k.Push(u32(0x53380d13))
    k.Push(u32(0x650a7354))
    k.Push(u32(0x766a0abb))
    k.Push(u32(0x81c2c92e))
    k.Push(u32(0x92722c85))
    k.Push(u32(0xa2bfe8a1))
    k.Push(u32(0xa81a664b))
    k.Push(u32(0xc24b8b70))
    k.Push(u32(0xc76c51a3))
    k.Push(u32(0xd192e819))
    k.Push(u32(0xd6990624))
    k.Push(u32(0xf40e3585))
    k.Push(u32(0x106aa070))
    k.Push(u32(0x19a4c116))
    k.Push(u32(0x1e376c08))
    k.Push(u32(0x2748774c))
    k.Push(u32(0x34b0bcb5))
    k.Push(u32(0x391c0cb3))
    k.Push(u32(0x4ed8aa4a))
    k.Push(u32(0x5b9cca4f))
    k.Push(u32(0x682e6ff3))
    k.Push(u32(0x748f82ee))
    k.Push(u32(0x78a5636f))
    k.Push(u32(0x84c87814))
    k.Push(u32(0x8cc70208))
    k.Push(u32(0x90befffa))
    k.Push(u32(0xa4506ceb))
    k.Push(u32(0xbef9a3f7))
    k.Push(u32(0xc67178f2))
    return k
}

// sha512_initial is the starting state of SHA-512: the first sixty-four bits of
// the fractional parts of the square roots of the first eight primes.
func sha512_initial() -> Array<u64> {
    var state = new Array<u64>(0)
    state.Push(u64(0x6a09e667f3bcc908))
    state.Push(u64(0xbb67ae8584caa73b))
    state.Push(u64(0x3c6ef372fe94f82b))
    state.Push(u64(0xa54ff53a5f1d36f1))
    state.Push(u64(0x510e527fade682d1))
    state.Push(u64(0x9b05688c2b3e6c1f))
    state.Push(u64(0x1f83d9abfb41bd6b))
    state.Push(u64(0x5be0cd19137e2179))
    return state
}

// sha512_round is the eighty round constants of SHA-512: the first sixty-four
// bits of the fractional parts of the cube roots of the first eighty primes.
