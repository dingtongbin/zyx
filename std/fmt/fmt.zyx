package fmt

import c "zyxrt.h"

// Print writes a string's UTF-8 bytes to standard output.
func Print(s: str) {
	c.zyxrt_print_str(s)
}

// Println writes a string and a line feed.
func Println(s: str) {
	c.zyxrt_print_str(s)
	c.zyxrt_print_nl()
}

// PrintI64 writes a signed integer in decimal.
func PrintI64(v: i64) {
	c.zyxrt_print_i64(v)
}

// PrintU64 writes an unsigned integer in decimal.
func PrintU64(v: u64) {
	c.zyxrt_print_u64(v)
}

// PrintF64 writes a floating-point value.
func PrintF64(v: f64) {
	c.zyxrt_print_f64(v)
}

// PrintBool writes true or false.
func PrintBool(v: bool) {
	c.zyxrt_print_bool(v)
}

// PrintChar writes one character as UTF-8.
func PrintChar(ch: char) {
	c.zyxrt_print_char(ch)
}

// PrintNl writes a line feed.
func PrintNl() {
	c.zyxrt_print_nl()
}

// PrintValue writes a value in the form its Show gives it.
func PrintValue<T: Show>(v: T) {
	var w = new Buf(0)
	v.Show(w)
	Print(w.Str())
}

// PrintlnValue writes a value in the form its Show gives it, then a line
// feed.
func PrintlnValue<T: Show>(v: T) {
	var w = new Buf(0)
	v.Show(w)
	Println(w.Str())
}

// Fprint writes a string's UTF-8 bytes into a buffer.
func Fprint(w: Buf, s: str) {
	w.WriteStr(s)
}

// Fprintln writes a string's UTF-8 bytes and a line feed into a buffer.
func Fprintln(w: Buf, s: str) {
	w.WriteStr(s)
	w.WriteByte(10)
}

// FprintValue writes a value into a buffer, in the form its Show gives it.
// The value writes itself, so a caller that gathers several values pays for
// one buffer rather than one string per value.
func FprintValue<T: Show>(w: Buf, v: T) {
	v.Show(w)
}

// SprintValue returns a value's text as a new string.
func SprintValue<T: Show>(v: T) -> str {
	var w = new Buf(0)
	v.Show(w)
	return w.Str()
}
