package yaml

import "std/fmt"

// YAML documents read into the Value of the language and written back from it,
// with the mapping the document packages share: a mapping becomes Obj, a
// sequence becomes Arr, and a scalar becomes the value its text stands for.
//
// The subset this package takes is the one a configuration file is usually
// written in: block mappings and sequences, flow mappings and sequences, plain
// and single-quoted and double-quoted and block scalars, comments, and the
// document markers. A construct whose meaning depends on a reader this package
// does not have is refused rather than read as something else: anchors, aliases,
// tags, directives, a stream that holds more than one document, and a flow
// collection or a plain scalar that is written over more than one line. A
// refusal is an Error that names the offset in the text at which the fault
// stands.
//
// A scalar written without quotes is taken as a null, a boolean, a number, or a
// string, in that order, by the shape of its text. An integer beyond 2^53 is
// refused rather than rounded in silence, because the Num of the language is a
// double.

// Error says why a document was refused. Pos is the byte offset in the text at
// which the fault stands and Msg names the fault.
struct Error {
    Pos: usize
    Msg: str

    impl Show {
        func Show(w: Buf) {
            w.WriteStr(f"yaml: {self.Msg} at {self.Pos}")
        }
    }
}

// exact_limit_int is the largest integer a double holds exactly.
const exact_limit_int: i64 = 9007199254740992

const lf: u8 = 10
const cr: u8 = 13

func code(ch: char) -> u8 {
    return u8(u32(ch))
}

func is_digit(b: u8) -> bool {
    return b >= code('0') && b <= code('9')
}

func is_hex_digit(b: u8) -> bool {
    return is_digit(b) || (b >= code('a') && b <= code('f')) || (b >= code('A') && b <= code('F'))
}

func hex_value(b: u8) -> u32 {
    if is_digit(b) {
        return u32(b - code('0'))
    }
    if b >= code('A') && b <= code('F') {
        return u32(b - code('A')) + 10
    }
    return u32(b - code('a')) + 10
}

func is_space(b: u8) -> bool {
    return b == code(' ') || b == code('\t')
}

// write_char writes a code point as UTF-8. The caller has checked that the code
// point is one a string may hold.
func write_char(out: Buf, cp: u32) {
    if cp < 0x80 {
        out.WriteByte(u8(cp))
        return
    }
    if cp < 0x800 {
        out.WriteByte(u8(0xC0 | (cp >> 6)))
        out.WriteByte(u8(0x80 | (cp & 0x3F)))
        return
    }
    if cp < 0x10000 {
        out.WriteByte(u8(0xE0 | (cp >> 12)))
        out.WriteByte(u8(0x80 | ((cp >> 6) & 0x3F)))
        out.WriteByte(u8(0x80 | (cp & 0x3F)))
        return
    }
    out.WriteByte(u8(0xF0 | (cp >> 18)))
    out.WriteByte(u8(0x80 | ((cp >> 12) & 0x3F)))
    out.WriteByte(u8(0x80 | ((cp >> 6) & 0x3F)))
    out.WriteByte(u8(0x80 | (cp & 0x3F)))
}

// trim_right answers a text without the spaces at its end.
func trim_right(text: str) -> str {
    var end = text.Len()
    for end > 0 && is_space(text[end - 1]) {
        end -= 1
    }
    return text[0 .. end]
}

// trim_left answers a text without the spaces at its start.
func trim_left(text: str) -> str {
    var i: usize = 0
    for i < text.Len() && is_space(text[i]) {
        i += 1
    }
    return text[i .. text.Len()]
}

// trim_comment answers a line without the comment it carries. A '#' starts a
// comment only where a space stands before it or at the start of the line.
func trim_comment(text: str) -> str {
    var i: usize = 0
    var quote: u8 = 0
    for i < text.Len() {
        var b = text[i]
        if quote != 0 {
            if b == quote {
                quote = 0
            }
        } else if b == code('"') || b == code('\'') {
            quote = b
        } else if b == code('#') && (i == 0 || is_space(text[i - 1])) {
            return trim_right(text[0 .. i])
        }
        i += 1
    }
    return trim_right(text)
}

// is_dash_line reports whether a line is an entry of a block sequence.
func is_dash_line(text: str) -> bool {
    if text.Len() == 0 || text[0] != code('-') {
        return false
    }
    return text.Len() == 1 || is_space(text[1])
}

// no_colon says that a line is not a mapping entry.
const no_colon: usize = ~usize(0)

// entry_colon answers the index of the ':' that separates a key from its value,
// or no_colon when the line is not a mapping entry.
func entry_colon(text: str) -> usize {
    if text.Len() == 0 {
        return no_colon
    }
    if text[0] == code('?') && (text.Len() == 1 || is_space(text[1])) {
        return no_colon
    }
    var i: usize = 0
    if text[0] == code('"') || text[0] == code('\'') {
        var quote = text[0]
        i = 1
        for i < text.Len() {
            if text[i] == quote {
                i += 1
                break
            }
            i += 1
        }
        if i < text.Len() && text[i] == code(':') {
            return i
        }
        return no_colon
    }
    for i < text.Len() {
        var ch = text[i]
        if ch == code(':') && (i + 1 == text.Len() || is_space(text[i + 1])) {
            return i
        }
        if ch == code('#') || ch == code('[') || ch == code(']') || ch == code('{') || ch == code('}') || ch == code(',') {
            return no_colon
        }
        i += 1
    }
    return no_colon
}

// Parser reads a document. The line the parser stands on is held apart from the
// text, with its indentation, because what a block holds is decided by the
// indentation of the lines it is made of.
struct Parser {
    src: str
    pos: usize
    has_line: bool
    line: Buf
    indent: usize
    at: usize

    // text answers the line the parser stands on.
    func text() -> str {
        return self.line.Str()
    }

    func error(offset: usize, msg: str) -> Error {
        return Error { Pos: offset, Msg: msg }
    }

    // read_raw reads the next line as it stands, indentation and all. It is what
    // a block scalar reads, because the lines of one are its content.
    func read_raw() -> Result<(), Error> {
        if self.pos >= self.src.Len() {
            self.has_line = false
            self.line.Reset()
            self.indent = 0
            self.at = self.src.Len()
            return Result.Ok()
        }
        var i = self.pos
        var spaces: usize = 0
        for i < self.src.Len() && self.src[i] == code(' ') {
            spaces += 1
            i += 1
        }
        if i < self.src.Len() && self.src[i] == code('\t') {
            return Result.Err(self.error(i, "a tab cannot stand where the indentation does"))
        }
        var end = i
        for end < self.src.Len() && self.src[end] != lf {
            end += 1
        }
        var stop = end
        if stop > i && self.src[stop - 1] == cr {
            stop -= 1
        }
        self.line.Reset()
        self.line.WriteStr(self.src[i .. stop])
        self.indent = spaces
        self.at = i
        self.has_line = true
        self.pos = end
        if self.pos < self.src.Len() {
            self.pos += 1
        }
        return Result.Ok()
    }

    // advance reads the next line that holds anything: a line that is blank or
    // holds only a comment is skipped, and a comment at the end of a line is
    // not part of it.
    func advance() -> Result<(), Error> {
        var done = false
        for !done {
            try self.read_raw()
            if !self.has_line {
                done = true
            } else {
                var text = trim_comment(self.text())
                if text.Len() > 0 {
                    self.line.Reset()
                    self.line.WriteStr(text)
                    done = true
                }
            }
        }
        return Result.Ok()
    }

    // node reads the node whose lines stand at or after an indentation.
    func node(min_indent: usize) -> Result<Value, Error> {
        if !self.has_line || self.indent < min_indent {
            return Result.Ok(Value.Null)
        }
        if is_dash_line(self.text()) {
            return self.sequence(self.indent)
        }
        if entry_colon(self.text()) != no_colon {
            return self.mapping(self.indent)
        }
        return self.inline(self.text())
    }

    // sequence reads the entries of a block sequence.
    func sequence(indent: usize) -> Result<Value, Error> {
        var items = new Array<Value>(0)
        for self.has_line && self.indent == indent && is_dash_line(self.text()) {
            var rest = trim_left(self.text()[1 .. self.text().Len()])
            try self.advance()
            var item = try self.item(rest, indent)
            items.Push(item)
        }
        return Result.Ok(Value.Arr(items))
    }

    // item reads one entry of a block sequence. The entry holds a mapping when
    // its first pair stands beside the dash.
    func item(rest: str, indent: usize) -> Result<Value, Error> {
        if rest.Len() == 0 {
            return self.node(indent + 1)
        }
        if entry_colon(rest) == no_colon {
            return self.inline(rest)
        }
        var table = new Map<str, Value>()
        var key_indent = indent + 2
        try self.entry(table, rest, key_indent)
        for self.has_line && self.indent == key_indent && entry_colon(self.text()) != no_colon {
            var text = self.text()
            try self.advance()
            try self.entry(table, text, key_indent)
        }
        return Result.Ok(Value.Obj(table))
    }

    // mapping reads the entries of a block mapping.
    func mapping(indent: usize) -> Result<Value, Error> {
        var table = new Map<str, Value>()
        for self.has_line && self.indent == indent && entry_colon(self.text()) != no_colon {
            var text = self.text()
            try self.advance()
            try self.entry(table, text, indent)
        }
        return Result.Ok(Value.Obj(table))
    }

    // entry puts one mapping entry in a table. The parser stands on the line
    // after the entry, and what the value is written on is either the entry's
    // own line or the lines under it.
    func entry(table: Map<str, Value>, text: str, key_indent: usize) -> Result<(), Error> {
        var colon = entry_colon(text)
        var key = try self.key_of(text[0 .. colon])
        var rest = trim_left(text[colon + 1 .. text.Len()])
        var value: Value = Value.Null
        if rest.Len() == 0 {
            value = try self.node(key_indent + 1)
        } else if rest[0] == code('|') || rest[0] == code('>') {
            value = try self.block_scalar(rest, key_indent)
        } else {
            value = try self.inline(rest)
        }
        if table.Contains(key) {
            return Result.Err(self.error(self.at, "the key is defined twice"))
        }
        table.Insert(key, value)
        return Result.Ok()
    }

    // key_of answers the key a mapping entry names, which may be quoted.
    func key_of(text: str) -> Result<str, Error> {
        var trimmed = trim_right(text)
        if trimmed.Len() == 0 {
            return Result.Err(self.error(self.at, "the entry has no key"))
        }
        if trimmed[0] == code('&') || trimmed[0] == code('*') || trimmed[0] == code('!') {
            return Result.Err(self.error(self.at, "an anchor, an alias or a tag is not taken"))
        }
        if trimmed.Len() > 1 && (trimmed[0] == code('"') || trimmed[0] == code('\'')) {
            var flow = Flow { src: trimmed, pos: 0, at: self.at }
            var value = try flow.quoted()
            return Result.Ok(string_of(value))
        }
        return Result.Ok(trimmed)
    }

    // inline reads a value that stands on one line: a quoted scalar, a flow
    // collection, or a plain scalar.
    func inline(text: str) -> Result<Value, Error> {
        var at = self.at
        var trimmed = trim_left(text)
        if trimmed.Len() == 0 {
            return Result.Ok(Value.Null)
        }
        var b = trimmed[0]
        if b == code('&') || b == code('*') {
            return Result.Err(self.error(at, "an anchor or an alias is not taken"))
        }
        if b == code('!') {
            return Result.Err(self.error(at, "a tag is not taken"))
        }
        if b == code('%') {
            return Result.Err(self.error(at, "a directive is not taken"))
        }
        if b == code('|') || b == code('>') {
            return Result.Err(self.error(at, "a block scalar stands only as the value of an entry"))
        }
        if b == code('"') || b == code('\'') || b == code('[') || b == code('{') {
            var flow = Flow { src: trimmed, pos: 0, at: at }
            return flow.value()
        }
        if trimmed == "---" || trimmed == "..." {
            return Result.Err(self.error(at, "a document marker stands where a value does"))
        }
        return Result.Ok(resolve(trim_right(trimmed)))
    }

    // block_scalar reads a scalar written as the lines under an entry.
    func block_scalar(header: str, key_indent: usize) -> Result<Value, Error> {
        var literal = header[0] == code('|')
        var chomp: i32 = 0
        var i: usize = 1
        for i < header.Len() {
            var b = header[i]
            if b == code('-') {
                chomp = -1
            } else if b == code('+') {
                chomp = 1
            } else {
                return Result.Err(self.error(self.at, "the header of a block scalar holds a byte it cannot"))
            }
            i += 1
        }
        var block_indent: usize = 0
        var seen = false
        var lines = new Array<str>(0)
        var trailing: usize = 0
        for self.has_line {
            if self.text().Len() == 0 {
                lines.Push("")
                trailing += 1
                try self.read_raw()
                continue
            }
            if self.indent <= key_indent {
                break
            }
            if !seen {
                block_indent = self.indent
                seen = true
            }
            if self.indent < block_indent {
                break
            }
            var extra = self.indent - block_indent
            var out = new Buf(0)
            var k: usize = 0
            for k < extra {
                out.WriteByte(code(' '))
                k += 1
            }
            out.WriteStr(self.text())
            lines.Push(out.Str())
            trailing = 0
            try self.read_raw()
        }
        var body = new Buf(0)
        if literal {
            var first = true
            for text in lines {
                if !first {
                    body.WriteByte(lf)
                }
                body.WriteStr(text)
                first = false
            }
        } else {
            var first = true
            var previous_more = false
            var after_break = false
            for text in lines {
                if text.Len() == 0 {
                    body.WriteByte(lf)
                    after_break = true
                    first = false
                    previous_more = false
                    continue
                }
                var more = text[0] == code(' ')
                if !first && !after_break {
                    if more || previous_more {
                        body.WriteByte(lf)
                    } else {
                        body.WriteByte(code(' '))
                    }
                }
                body.WriteStr(text)
                after_break = false
                first = false
                previous_more = more
            }
        }
        var content = body.Str()
        var end = content.Len()
        for end > 0 && content[end - 1] == lf {
            end -= 1
        }
        var clipped = content[0 .. end]
        if chomp < 0 {
            return Result.Ok(Value.Str(clipped))
        }
        if chomp > 0 {
            var kept = new Buf(0)
            kept.WriteStr(clipped)
            var k: usize = 0
            for k < trailing + 1 {
                kept.WriteByte(lf)
                k += 1
            }
            return Result.Ok(Value.Str(kept.Str()))
        }
        if clipped.Len() == 0 {
            return Result.Ok(Value.Str(""))
        }
        var out = new Buf(0)
        out.WriteStr(clipped)
        out.WriteByte(lf)
        return Result.Ok(Value.Str(out.Str()))
    }
}

// string_of answers the text of a value the flow reader answered.
func string_of(v: Value) -> str {
    match v {
        Str(text) => {
            return text
        }
        _ => {
            return ""
        }
    }
}

// Flow reads a value that stands inside one line: a flow collection, or a
// quoted scalar.
struct Flow {
    src: str
    pos: usize
    at: usize

    func error(offset: usize, msg: str) -> Error {
        return Error { Pos: offset, Msg: msg }
    }

    func at_end() -> bool {
        return self.pos >= self.src.Len()
    }

    func peek() -> u8 {
        return self.src[self.pos]
    }

    func skip_space() {
        for !self.at_end() && is_space(self.peek()) {
            self.pos += 1
        }
    }

    // quoted reads a scalar between quotes.
    func quoted() -> Result<Value, Error> {
        var quote = self.peek()
        var start = self.pos
        self.pos += 1
        var out = new Buf(0)
        for !self.at_end() {
            var b = self.peek()
            if b == quote {
                if quote == code('\'') && self.pos + 1 < self.src.Len() && self.src[self.pos + 1] == code('\'') {
                    out.WriteByte(code('\''))
                    self.pos += 2
                    continue
                }
                self.pos += 1
                return Result.Ok(Value.Str(out.Str()))
            }
            if quote == code('"') && b == code('\\') {
                try self.escape(out)
                continue
            }
            if b == lf {
                return Result.Err(self.error(self.at + start, "the string is never closed"))
            }
            out.WriteByte(b)
            self.pos += 1
        }
        return Result.Err(self.error(self.at + start, "the string is never closed"))
    }

    // escape reads one escape of a double-quoted scalar.
    func escape(out: Buf) -> Result<(), Error> {
        var start = self.pos
        self.pos += 1
        if self.at_end() {
            return Result.Err(self.error(self.at + start, "the escape is not one a string holds"))
        }
        var b = self.peek()
        self.pos += 1
        if b == code('0') {
            out.WriteByte(0)
            return Result.Ok()
        }
        if b == code('a') {
            out.WriteByte(7)
            return Result.Ok()
        }
        if b == code('b') {
            out.WriteByte(8)
            return Result.Ok()
        }
        if b == code('t') {
            out.WriteByte(9)
            return Result.Ok()
        }
        if b == code('n') {
            out.WriteByte(lf)
            return Result.Ok()
        }
        if b == code('v') {
            out.WriteByte(11)
            return Result.Ok()
        }
        if b == code('f') {
            out.WriteByte(12)
            return Result.Ok()
        }
        if b == code('r') {
            out.WriteByte(cr)
            return Result.Ok()
        }
        if b == code('e') {
            out.WriteByte(27)
            return Result.Ok()
        }
        if b == code('"') || b == code('\\') || b == code('/') {
            out.WriteByte(b)
            return Result.Ok()
        }
        if b == code('x') {
            var cp = try self.hex_code_point(start, 2)
            write_char(out, cp)
            return Result.Ok()
        }
        if b == code('u') {
            var cp = try self.hex_code_point(start, 4)
            write_char(out, cp)
            return Result.Ok()
        }
        if b == code('U') {
            var cp = try self.hex_code_point(start, 8)
            write_char(out, cp)
            return Result.Ok()
        }
        return Result.Err(self.error(self.at + start, "the escape is not one a string holds"))
    }

    // hex_code_point reads the hexadecimal code point of an escape.
    func hex_code_point(start: usize, width: usize) -> Result<u32, Error> {
        var value: u32 = 0
        var i: usize = 0
        for i < width {
            if self.at_end() || !is_hex_digit(self.peek()) {
                return Result.Err(self.error(self.at + start, "the escape is missing a hexadecimal digit"))
            }
            value = value * 16 + hex_value(self.peek())
            self.pos += 1
            i += 1
        }
        if value > 0x10FFFF || (value >= 0xD800 && value <= 0xDFFF) {
            return Result.Err(self.error(self.at + start, "the code point is not one a string holds"))
        }
        return Result.Ok(value)
    }

    // value reads one value of a flow collection.
    func value() -> Result<Value, Error> {
        self.skip_space()
        if self.at_end() {
            return Result.Err(self.error(self.at, "a value is missing"))
        }
        var b = self.peek()
        if b == code('&') || b == code('*') {
            return Result.Err(self.error(self.at + self.pos, "an anchor or an alias is not taken"))
        }
        if b == code('!') {
            return Result.Err(self.error(self.at + self.pos, "a tag is not taken"))
        }
        if b == code('"') || b == code('\'') {
            return self.quoted()
        }
        if b == code('[') {
            return self.sequence()
        }
        if b == code('{') {
            return self.mapping()
        }
        return self.plain()
    }

    // plain reads a scalar that is not quoted, up to the byte that ends it.
    func plain() -> Result<Value, Error> {
        var start = self.pos
        var end = self.pos
        for !self.at_end() {
            var b = self.peek()
            if b == code(',') || b == code(']') || b == code('}') {
                break
            }
            self.pos += 1
            end = self.pos
        }
        var text = trim_right(self.src[start .. end])
        if text.Len() == 0 {
            return Result.Err(self.error(self.at + start, "a value is missing"))
        }
        return Result.Ok(resolve(text))
    }

    // sequence reads a flow sequence.
    func sequence() -> Result<Value, Error> {
        var at = self.pos
        self.pos += 1
        var items = new Array<Value>(0)
        self.skip_space()
        if !self.at_end() && self.peek() == code(']') {
            self.pos += 1
            return Result.Ok(Value.Arr(items))
        }
        for !self.at_end() {
            var item = try self.value()
            items.Push(item)
            self.skip_space()
            if self.at_end() {
                break
            }
            if self.peek() == code(',') {
                self.pos += 1
                self.skip_space()
                if !self.at_end() && self.peek() == code(']') {
                    self.pos += 1
                    return Result.Ok(Value.Arr(items))
                }
                continue
            }
            if self.peek() == code(']') {
                self.pos += 1
                return Result.Ok(Value.Arr(items))
            }
            return Result.Err(self.error(self.at + self.pos, "the entries of the sequence are not separated by commas"))
        }
        return Result.Err(self.error(self.at + at, "the flow sequence is never closed"))
    }

    // mapping reads a flow mapping.
    func mapping() -> Result<Value, Error> {
        var at = self.pos
        self.pos += 1
        var table = new Map<str, Value>()
        self.skip_space()
        if !self.at_end() && self.peek() == code('}') {
            self.pos += 1
            return Result.Ok(Value.Obj(table))
        }
        for !self.at_end() {
            self.skip_space()
            var key = try self.flow_key()
            self.skip_space()
            if self.at_end() || self.peek() != code(':') {
                return Result.Err(self.error(self.at + self.pos, "an entry of the flow mapping has no value"))
            }
            self.pos += 1
            var value = try self.value()
            if table.Contains(key) {
                return Result.Err(self.error(self.at + self.pos, "the key is defined twice"))
            }
            table.Insert(key, value)
            self.skip_space()
            if self.at_end() {
                break
            }
            if self.peek() == code(',') {
                self.pos += 1
                self.skip_space()
                if !self.at_end() && self.peek() == code('}') {
                    self.pos += 1
                    return Result.Ok(Value.Obj(table))
                }
                continue
            }
            if self.peek() == code('}') {
                self.pos += 1
                return Result.Ok(Value.Obj(table))
            }
            return Result.Err(self.error(self.at + self.pos, "the entries of the mapping are not separated by commas"))
        }
        return Result.Err(self.error(self.at + at, "the flow mapping is never closed"))
    }

    // flow_key reads the key of an entry of a flow mapping.
    func flow_key() -> Result<str, Error> {
        if self.at_end() {
            return Result.Err(self.error(self.at + self.pos, "the entry has no key"))
        }
        var b = self.peek()
        if b == code('"') || b == code('\'') {
            var value = try self.quoted()
            return Result.Ok(string_of(value))
        }
        var start = self.pos
        var end = self.pos
        for !self.at_end() {
            var ch = self.peek()
            if ch == code(':') || ch == code(',') || ch == code('}') {
                break
            }
            self.pos += 1
            end = self.pos
        }
        var text = trim_right(self.src[start .. end])
        if text.Len() == 0 {
            return Result.Err(self.error(self.at + start, "the entry has no key"))
        }
        return Result.Ok(text)
    }
}

// Parse reads a document into a Value.
func Parse(s: str) -> Result<Value, Error> {
    var p = Parser { src: s, pos: 0, has_line: false, line: new Buf(0), indent: 0, at: 0 }
    try p.advance()
    if p.has_line && p.text() == "---" {
        try p.advance()
    }
    if !p.has_line {
        return Result.Ok(Value.Null)
    }
    var doc = try p.node(0)
    if p.has_line && (p.text() == "..." || p.text() == "---") {
        try p.advance()
    }
    if p.has_line {
        return Result.Err(p.error(p.at, "the line stands at an indentation no block holds"))
    }
    return Result.Ok(doc)
}

// resolve answers the value a scalar written without quotes stands for: a null,
// a boolean, a number, or the string itself.
func resolve(text: str) -> Value {
    if text.Len() == 0 {
        return Value.Null
    }
    if text == "~" || text == "null" || text == "Null" || text == "NULL" {
        return Value.Null
    }
    if text == "true" || text == "True" || text == "TRUE" {
        return Value.Bool(true)
    }
    if text == "false" || text == "False" || text == "FALSE" {
        return Value.Bool(false)
    }
    var kind = number_kind(text)
    if kind == number_integer {
        match integer_of(text) {
            Some(v) => {
                if v > exact_limit_int || v < -exact_limit_int {
                    return Value.Str(text)
                }
                return Value.Num(f64(v))
            }
            None => { }
        }
        return Value.Str(text)
    }
    if kind == number_float {
        match float_of(text) {
            Some(v) => {
                return Value.Num(v)
            }
            None => { }
        }
    }
    return Value.Str(text)
}

const number_invalid: i32 = 0
const number_integer: i32 = 1
const number_float: i32 = 2

// number_kind answers what the shape of a text says it is.
func number_kind(text: str) -> i32 {
    if text == ".inf" || text == ".Inf" || text == ".INF" {
        return number_float
    }
    if text == "+.inf" || text == "-.inf" {
        return number_float
    }
    if text == ".nan" || text == ".NaN" || text == ".NAN" {
        return number_float
    }
    var i: usize = 0
    if text[0] == code('-') || text[0] == code('+') {
        i = 1
    }
    if i >= text.Len() {
        return number_invalid
    }
    if text[i] == code('.') {
        return number_invalid
    }
    if i + 1 < text.Len() && text[i] == code('0') {
        var prefix = text[i + 1]
        if prefix == code('x') || prefix == code('o') || prefix == code('b') {
            return number_integer
        }
    }
    var is_float = false
    var digits: usize = 0
    var seen_point = false
    for i < text.Len() {
        var b = text[i]
        if is_digit(b) {
            digits += 1
            i += 1
            continue
        }
        if b == code('_') || b == code(',') {
            i += 1
            continue
        }
        if b == code('.') && !seen_point {
            seen_point = true
            is_float = true
            i += 1
            continue
        }
        if b == code('e') || b == code('E') {
            is_float = true
            i += 1
            continue
        }
        if (b == code('-') || b == code('+')) && i > 0 && (text[i - 1] == code('e') || text[i - 1] == code('E')) {
            i += 1
            continue
        }
        return number_invalid
    }
    if digits == 0 {
        return number_invalid
    }
    if text[0] == code('.') {
        return number_invalid
    }
    if is_float {
        return number_float
    }
    return number_integer
}

// integer_of answers the whole number a text stands for, or nothing when its
// text is not one this package takes.
func integer_of(text: str) -> Option<i64> {
    var i: usize = 0
    var negative = false
    if text[i] == code('-') {
        negative = true
        i += 1
    } else if text[i] == code('+') {
        i += 1
    }
    var base: i64 = 10
    if i + 1 < text.Len() && text[i] == code('0') {
        var prefix = text[i + 1]
        if prefix == code('x') {
            base = 16
            i += 2
        } else if prefix == code('o') {
            base = 8
            i += 2
        } else if prefix == code('b') {
            base = 2
            i += 2
        }
    }
    var value: i64 = 0
    var digits: usize = 0
    for i < text.Len() {
        var b = text[i]
        if b == code('_') || b == code(',') {
            i += 1
            continue
        }
        var d: i64 = -1
        if is_digit(b) {
            d = i64(b - code('0'))
        } else if is_hex_digit(b) {
            d = i64(hex_value(b))
        }
        if d < 0 || d >= base {
            return Option.None
        }
        if value > (9223372036854775807 - d) / base {
            return Option.None
        }
        value = value * base + d
        digits += 1
        i += 1
    }
    if digits == 0 {
        return Option.None
    }
    if negative {
        return Option.Some(-value)
    }
    return Option.Some(value)
}

// float_of answers the number a text stands for, or nothing when its text is
// not one this package takes.
func float_of(text: str) -> Option<f64> {
    if text == ".inf" || text == ".Inf" || text == ".INF" || text == "+.inf" {
        var big = 1.0 / 0.0
        return Option.Some(big)
    }
    if text == "-.inf" {
        var small = -1.0 / 0.0
        return Option.Some(small)
    }
    if text == ".nan" || text == ".NaN" || text == ".NAN" {
        var none = 0.0 / 0.0
        return Option.Some(none)
    }
    var i: usize = 0
    var negative = false
    if text[i] == code('-') {
        negative = true
        i += 1
    } else if text[i] == code('+') {
        i += 1
    }
    var mantissa: u64 = 0
    var digits: usize = 0
    var exponent: i32 = 0
    var seen_point = false
    for i < text.Len() {
        var b = text[i]
        if b == code('_') || b == code(',') {
            i += 1
            continue
        }
        if b == code('.') {
            if seen_point {
                return Option.None
            }
            seen_point = true
            i += 1
            continue
        }
        if b == code('e') || b == code('E') {
            var e = exponent_of(text, i + 1)
            match e {
                Some(v) => {
                    exponent += v
                }
                None => {
                    return Option.None
                }
            }
            i = text.Len()
            continue
        }
        if !is_digit(b) {
            return Option.None
        }
        var d = u32(b - code('0'))
        if mantissa < 1844674407370955161 {
            mantissa = mantissa * 10 + u64(d)
            if seen_point {
                exponent -= 1
            }
        } else if !seen_point {
            exponent += 1
        }
        digits += 1
        i += 1
    }
    if digits == 0 {
        return Option.None
    }
    var value = scale(mantissa, exponent)
    if negative {
        return Option.Some(-value)
    }
    return Option.Some(value)
}

// exponent_of answers the power a text names after its 'e'.
func exponent_of(text: str, from: usize) -> Option<i32> {
    var i = from
    var negative = false
    if i < text.Len() && (text[i] == code('-') || text[i] == code('+')) {
        negative = text[i] == code('-')
        i += 1
    }
    var value: i32 = 0
    var digits: usize = 0
    for i < text.Len() {
        var b = text[i]
        if b == code('_') || b == code(',') {
            i += 1
            continue
        }
        if !is_digit(b) {
            return Option.None
        }
        if value < 100000 {
            value = value * 10 + i32(b - code('0'))
        }
        digits += 1
        i += 1
    }
    if digits == 0 {
        return Option.None
    }
    if negative {
        return Option.Some(-value)
    }
    return Option.Some(value)
}

// scale answers the double a whole mantissa and a power of ten stand for.
func scale(mantissa: u64, exponent: i32) -> f64 {
    var value = f64(mantissa)
    if exponent == 0 {
        return value
    }
    if exponent > 0 {
        if exponent <= 22 && mantissa < 9007199254740992 {
            return value * power_of_ten(exponent)
        }
        var left = exponent
        for left > 0 {
            var step = left
            if step > 22 {
                step = 22
            }
            value = value * power_of_ten(step)
            left -= step
        }
        return value
    }
    var down = -exponent
    if down <= 22 && mantissa < 9007199254740992 {
        return value / power_of_ten(down)
    }
    var left = down
    for left > 0 {
        var step = left
        if step > 22 {
            step = 22
        }
        value = value / power_of_ten(step)
        left -= step
    }
    return value
}

// power_of_ten answers ten raised to a power up to twenty-two, where every such
// power is a double exactly.
func power_of_ten(exponent: i32) -> f64 {
    var value = 1.0
    var i: i32 = 0
    for i < exponent {
        value = value * 10.0
        i += 1
    }
    return value
}

// Encode writes a value as a document.
func Encode(dst: Buf, v: Value) {
    write_node(dst, v, 0)
}

// write_node writes a value as a node at an indentation. A scalar stands on the
// line of the indentation; a collection stands under it, one part per line.
func write_node(dst: Buf, v: Value, indent: usize) {
    match v {
        Obj(o) => {
            if o.Len() == 0 {
                write_indent(dst, indent)
                dst.WriteStr("{}\n")
                return
            }
            write_mapping(dst, o, indent)
        }
        Arr(a) => {
            if a.Len() == 0 {
                write_indent(dst, indent)
                dst.WriteStr("[]\n")
                return
            }
            write_sequence(dst, a, indent)
        }
        _ => {
            write_indent(dst, indent)
            write_scalar(dst, v)
            dst.WriteByte(lf)
        }
    }
}

// write_mapping writes the entries of a mapping, each on a line of its own.
func write_mapping(dst: Buf, table: Map<str, Value>, indent: usize) {
    for key in sorted_keys(table) {
        write_indent(dst, indent)
        write_key(dst, key)
        dst.WriteByte(code(':'))
        match table.Get(key) {
            Some(value) => {
                if is_plain_node(value) {
                    dst.WriteByte(code(' '))
                    write_scalar(dst, value)
                    dst.WriteByte(lf)
                } else {
                    dst.WriteByte(lf)
                    write_node(dst, value, indent + 2)
                }
            }
            None => {
                dst.WriteStr(" null\n")
            }
        }
    }
}

// write_sequence writes the entries of a sequence, each on a line of its own.
func write_sequence(dst: Buf, items: Array<Value>, indent: usize) {
    for item in items {
        write_indent(dst, indent)
        dst.WriteByte(code('-'))
        if is_plain_node(item) {
            dst.WriteByte(code(' '))
            write_scalar(dst, item)
            dst.WriteByte(lf)
        } else {
            dst.WriteByte(lf)
            write_node(dst, item, indent + 2)
        }
    }
}

// is_plain_node reports whether a value may stand on the line of the entry that
// names it: a scalar, or a collection that holds nothing.
func is_plain_node(v: Value) -> bool {
    match v {
        Obj(o) => {
            return o.Len() == 0
        }
        Arr(a) => {
            return a.Len() == 0
        }
        _ => {
            return true
        }
    }
}

// write_indent writes the spaces that stand before a node.
func write_indent(dst: Buf, indent: usize) {
    var i: usize = 0
    for i < indent {
        dst.WriteByte(code(' '))
        i += 1
    }
}

// write_key writes the key of an entry, quoted when its text needs quoting.
func write_key(dst: Buf, key: str) {
    if is_plain_text(key) {
        dst.WriteStr(key)
        return
    }
    dst.WriteByte(code('"'))
    write_quoted_body(dst, key)
    dst.WriteByte(code('"'))
}

// write_scalar writes a value that is not a collection.
func write_scalar(dst: Buf, v: Value) {
    match v {
        Null => {
            dst.WriteStr("null")
        }
        Bool(b) => {
            if b {
                dst.WriteStr("true")
            } else {
                dst.WriteStr("false")
            }
        }
        Num(n) => {
            write_number(dst, n)
        }
        Str(text) => {
            if is_plain_text(text) {
                dst.WriteStr(text)
            } else {
                dst.WriteByte(code('"'))
                write_quoted_body(dst, text)
                dst.WriteByte(code('"'))
            }
        }
        Obj(o) => {
            dst.WriteStr("{}")
        }
        Arr(a) => {
            dst.WriteStr("[]")
        }
    }
}

// write_number writes a number in a form this package reads back as a number.
func write_number(dst: Buf, v: f64) {
    if v != v {
        dst.WriteStr(".nan")
        return
    }
    if v > 1.7976931348623157e308 {
        dst.WriteStr(".inf")
        return
    }
    if v < -1.7976931348623157e308 {
        dst.WriteStr("-.inf")
        return
    }
    var text = new Buf(0)
    fmt.FprintValue(text, v)
    dst.WriteStr(text.Str())
}

// write_quoted_body writes the body of a double-quoted scalar: the bytes as they
// are where they may stand, and an escape where they may not.
func write_quoted_body(dst: Buf, text: str) {
    var i: usize = 0
    for i < text.Len() {
        var b = text[i]
        if b == code('"') {
            dst.WriteStr("\\\"")
        } else if b == code('\\') {
            dst.WriteStr("\\\\")
        } else if b == code('0') {
            dst.WriteStr("\\0")
        } else if b == 7 {
            dst.WriteStr("\\a")
        } else if b == 8 {
            dst.WriteStr("\\b")
        } else if b == 9 {
            dst.WriteStr("\\t")
        } else if b == lf {
            dst.WriteStr("\\n")
        } else if b == 11 {
            dst.WriteStr("\\v")
        } else if b == 12 {
            dst.WriteStr("\\f")
        } else if b == cr {
            dst.WriteStr("\\r")
        } else if b == 27 {
            dst.WriteStr("\\e")
        } else if b < 0x20 || b == 0x7F {
            dst.WriteStr("\\x")
            write_hex2(dst, u32(b))
        } else {
            dst.WriteByte(b)
        }
        i += 1
    }
}

// write_hex2 writes a byte as the two hexadecimal digits of an escape.
func write_hex2(dst: Buf, value: u32) {
    var digits = "0123456789ABCDEF"
    dst.WriteByte(digits[usize((value >> 4) & 15)])
    dst.WriteByte(digits[usize(value & 15)])
}

// is_plain_text reports whether a text may stand in a document without quotes.
// A text that would read back as something else, or that holds a byte a plain
// scalar may not hold, is quoted instead.
func is_plain_text(text: str) -> bool {
    if text.Len() == 0 {
        return false
    }
    if is_space(text[0]) || is_space(text[text.Len() - 1]) {
        return false
    }
    var first = text[0]
    if first == code('-') || first == code('?') || first == code(':') || first == code(',') {
        return false
    }
    if first == code('[') || first == code(']') || first == code('{') || first == code('}') {
        return false
    }
    if first == code('&') || first == code('*') || first == code('!') || first == code('|') || first == code('>') {
        return false
    }
    if first == code('\'') || first == code('"') || first == code('%') || first == code('@') || first == code('`') {
        return false
    }
    var i: usize = 0
    for i < text.Len() {
        var b = text[i]
        if b == code(':') || b == code('#') || b == lf || b == cr || b == code('\t') {
            return false
        }
        if b < 0x20 || b == 0x7F {
            return false
        }
        i += 1
    }
    match resolve(text) {
        Str(_) => {
            return true
        }
        _ => {
            return false
        }
    }
}

// less orders two strings by their bytes.
func less(a: str, b: str) -> bool {
    var n = a.Len()
    if b.Len() < n {
        n = b.Len()
    }
    var i: usize = 0
    for i < n {
        if a[i] != b[i] {
            return a[i] < b[i]
        }
        i += 1
    }
    return a.Len() < b.Len()
}

// sorted_keys answers the keys of a table in byte order, which is what makes a
// document written twice the same bytes.
func sorted_keys(table: Map<str, Value>) -> Array<str> {
    var keys = table.KeyList()
    var i: usize = 1
    for i < keys.Len() {
        var key = keys[i]
        var j = i
        for j > 0 && less(key, keys[j - 1]) {
            keys[j] = keys[j - 1]
            j -= 1
        }
        keys[j] = key
        i += 1
    }
    return keys
}
