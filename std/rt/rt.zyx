package rt

// The runtime's own entries: the event loop a program reaches through the
// waits below, and the picture of the runtime a program prints when it is
// looking for a problem. A descriptor a program waits on must be non-blocking
// and pollable; everything else goes through the blocking pool.

import c "zyxrt.h" {
    fast zyxrt_loop_wait, zyxrt_loop_release, zyxrt_loop_wait_until, zyxrt_deadline_after
}

// ErrorKind is what went wrong. Every system package reports failures in
// this shape, so one program reads them the same way wherever they come
// from.
enum ErrorKind {
    NotFound
    Permission
    Exists
    NotDir
    IsDir
    Invalid
    Closed
    Timeout
    Interrupted
    WouldBlock
    Eof
    AddrInUse
    AddrNotAvailable
    Refused
    Reset
    Unreachable
    Other
}

// Error is one failure of a runtime entry.
struct Error {
    Kind: ErrorKind
    Errno: i32
    Msg: str

    impl Show {
        func Show(w: Buf) {
            w.WriteStr(f"rt: {self.Msg}")
        }
    }
}

// WaitReadable parks the calling coroutine until the descriptor can be read
// from, which is what a coroutine does instead of blocking a scheduler
// thread.
func WaitReadable(fd: i32) -> Result<(), Error> {
    return wait(fd, 1)
}

// WaitWritable parks the calling coroutine until the descriptor can be
// written to.
func WaitWritable(fd: i32) -> Result<(), Error> {
    return wait(fd, 2)
}

// WaitReadableUntil parks the calling coroutine until the descriptor can be read
// from or until the deadline passes, whichever comes first. The deadline is
// absolute, and DeadlineAfter turns a duration into one; a wait that ended
// because the deadline passed answers Timeout.
func WaitReadableUntil(fd: i32, deadline: u64) -> Result<(), Error> {
    return wait_until(fd, 1, deadline)
}

// WaitWritableUntil is WaitReadableUntil for writing.
func WaitWritableUntil(fd: i32, deadline: u64) -> Result<(), Error> {
    return wait_until(fd, 2, deadline)
}

// DeadlineAfter answers the absolute deadline a wait of ns nanoseconds from now
// ends at, read from the clock the runtime's waits read, so a program states a
// timeout as a duration rather than as a reading of a clock it does not own.
func DeadlineAfter(ns: u64) -> u64 {
    return c.zyxrt_deadline_after(ns)
}

// wait parks the calling coroutine until the descriptor is ready for the
// events asked for, and turns the answer of the runtime into the result the
// caller reads.
func wait(fd: i32, events: i32) -> Result<(), Error> {
    var code = c.zyxrt_loop_wait(fd, events)
    if code == 0 {
        return Result.Ok()
    }
    if code == 1 {
        return Result.Err(Error { Kind: ErrorKind.Closed, Errno: 0, Msg: "the descriptor was released" })
    }
    return Result.Err(Error { Kind: ErrorKind.Other, Errno: 0, Msg: "the target has no event loop for this descriptor" })
}

// wait_until is wait with a deadline, and adds the answer the runtime gives when
// the deadline is what ended the wait.
func wait_until(fd: i32, events: i32, deadline: u64) -> Result<(), Error> {
    var code = c.zyxrt_loop_wait_until(fd, events, deadline)
    if code == 0 {
        return Result.Ok()
    }
    if code == 1 {
        return Result.Err(Error { Kind: ErrorKind.Closed, Errno: 0, Msg: "the descriptor was released" })
    }
    if code == 3 {
        return Result.Err(Error { Kind: ErrorKind.Timeout, Errno: 0, Msg: "the wait reached its deadline" })
    }
    return Result.Err(Error { Kind: ErrorKind.Other, Errno: 0, Msg: "the target has no event loop for this descriptor" })
}

// Release unregisters a descriptor and wakes everyone waiting on it, so the
// program can close it without leaving a coroutine waiting forever. It is
// idempotent, and a descriptor it released is done with.
func Release(fd: i32) {
    c.zyxrt_loop_release(fd)
}
