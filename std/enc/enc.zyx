package enc

// Writing bytes as text and reading text back: base64 in the standard and the
// URL-safe alphabet, and hexadecimal in either case. A decoder refuses what it
// cannot decode rather than guessing, so a caller that expected valid input
// learns that it was not.

enum Error {
    InvalidLength
    InvalidChar(u8)
    InvalidPadding
}

// The alphabets. Base64 has two, and the decoder accepts either, so what
// EncodeURL wrote decodes as well as what Encode wrote.
const standard: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
const urlsafe: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
const lower_hex: str = "0123456789abcdef"
const upper_hex: str = "0123456789ABCDEF"

// length counts the bytes of a view. A slice carries its length, but the
// language gives no method for it, so the count is taken by walking once.
func length(src: [u8]) -> usize {
    var n: usize = 0
    for _ in src {
        n += 1
    }
    return n
}

// byte_of returns the byte of an ASCII character, which is what the decoding
// tables compare against.
func byte_of(ch: char) -> u8 {
    return u8(u32(ch))
}

// Encode writes src in the standard base64 alphabet, with padding.
func Encode(dst: Buf, src: [u8]) {
    encode(dst, src, standard, true)
}

// EncodeURL writes src in the URL-safe alphabet, without padding.
func EncodeURL(dst: Buf, src: [u8]) {
    encode(dst, src, urlsafe, false)
}

// encode writes src in one alphabet. Three bytes become four characters, and a
// shorter last group becomes three characters and a padding character, or
// fewer when the alphabet pads nothing.
func encode(dst: Buf, src: [u8], alphabet: str, pad: bool) {
    var n = length(src)
    var i: usize = 0
    for i + 3 <= n {
        var a = u32(src[i])
        var b = u32(src[i + 1])
        var third = u32(src[i + 2])
        dst.WriteByte(alphabet[usize((a >> 2) & 63)])
        dst.WriteByte(alphabet[usize(((a & 3) << 4) | (b >> 4))])
        dst.WriteByte(alphabet[usize(((b & 15) << 2) | (third >> 6))])
        dst.WriteByte(alphabet[usize(third & 63)])
        i += 3
    }
    if i + 1 == n {
        var a = u32(src[i])
        dst.WriteByte(alphabet[usize((a >> 2) & 63)])
        dst.WriteByte(alphabet[usize((a & 3) << 4)])
        if pad {
            dst.WriteByte(byte_of('='))
            dst.WriteByte(byte_of('='))
        }
        return
    }
    if i + 2 == n {
        var a = u32(src[i])
        var b = u32(src[i + 1])
        dst.WriteByte(alphabet[usize((a >> 2) & 63)])
        dst.WriteByte(alphabet[usize(((a & 3) << 4) | (b >> 4))])
        dst.WriteByte(alphabet[usize((b & 15) << 2)])
        if pad {
            dst.WriteByte(byte_of('='))
        }
    }
}

// EncodeToString writes src in the standard alphabet into a string of its own.
func EncodeToString(src: [u8]) -> str {
    var n = length(src)
    var dst = new Buf((n + 2) / 3 * 4)
    Encode(dst, src)
    return dst.Str()
}

// value_of returns the six bits a character stands for, or -1 when it stands
// for none.
func value_of(ch: u8) -> i32 {
    var i: usize = 0
    for i < 64 {
        if standard[i] == ch || urlsafe[i] == ch {
            return i32(i)
        }
        i += 1
    }
    return -1
}

// bad_char names the fault a character is: padding where data belongs is a
// padding fault, and anything else outside the alphabet is an invalid one.
func bad_char(ch: u8) -> Error {
    if ch == byte_of('=') {
        return Error.InvalidPadding
    }
    return Error.InvalidChar(ch)
}

// scan walks the groups of the text and reports the fault it has, if any. It
// runs before any byte is written, because a decoder that failed halfway
// would otherwise leave a partial result in the buffer it was given.
func scan(src: str) -> Option<Error> {
    var n = src.Len()
    if n % 4 == 1 {
        // A group of one character carries six bits, which no byte holds.
        return Option.Some(Error.InvalidLength)
    }
    var i: usize = 0
    for i < n {
        var group = n - i
        if group > 4 {
            group = 4
        }
        // The characters of this group that carry bits, and the padding that
        // closes the last one.
        var data = group
        for data > 0 && src[i + data - 1] == byte_of('=') {
            data -= 1
        }
        for k in data .. group {
            if src[i + k] != byte_of('=') {
                return Option.Some(Error.InvalidPadding)
            }
        }
        if data == 0 || (group < 4 && data < group) {
            // An entirely padded group, or padding on a group the text does
            // not close, is padding where data belongs.
            return Option.Some(Error.InvalidPadding)
        }
        if data == 1 {
            // One character of a group carries six bits, which no byte holds.
            return Option.Some(Error.InvalidLength)
        }
        var at: usize = 0
        for at < data {
            if value_of(src[i + at]) < 0 {
                return Option.Some(bad_char(src[i + at]))
            }
            at += 1
        }
        i += group
    }
    return Option.None
}

// Decode reads base64 into dst. Padding at the end is optional and both
// alphabets are accepted, so text written by either encoder reads back. The
// text is checked before a byte is written, so a caller that gets an error
// keeps the buffer it gave.
func Decode(dst: Buf, src: str) -> Result<(), Error> {
    match scan(src) {
        Some(e) => return Result.Err(e)
        None => { }
    }
    var n = src.Len()
    var i: usize = 0
    for i < n {
        var group = n - i
        if group > 4 {
            group = 4
        }
        var data = group
        for data > 0 && src[i + data - 1] == byte_of('=') {
            data -= 1
        }
        var a = value_of(src[i])
        var b = value_of(src[i + 1])
        dst.WriteByte(u8((a << 2) | (b >> 4)))
        if data >= 3 {
            var third = value_of(src[i + 2])
            dst.WriteByte(u8(((b & 15) << 4) | (third >> 2)))
            if data == 4 {
                dst.WriteByte(u8(((third & 3) << 6) | value_of(src[i + 3])))
            }
        }
        i += group
    }
    return Result.Ok()
}

// DecodeString reads base64 into an array of its own.
func DecodeString(s: str) -> Result<Array<u8>, Error> {
    var buf = new Buf()
    try Decode(buf, s)
    var out = new Array<u8>(0)
    for b in buf.Bytes() {
        out.Push(b)
    }
    return Result.Ok(out)
}

// EncodeHex writes src as lowercase hexadecimal.
func EncodeHex(dst: Buf, src: [u8]) {
    write_hex(dst, src, lower_hex)
}

// EncodeHexUpper writes src as uppercase hexadecimal.
func EncodeHexUpper(dst: Buf, src: [u8]) {
    write_hex(dst, src, upper_hex)
}

// write_hex writes one byte as two characters of an alphabet of sixteen.
func write_hex(dst: Buf, src: [u8], digits: str) {
    var n = length(src)
    var i: usize = 0
    for i < n {
        var b = u32(src[i])
        dst.WriteByte(digits[usize(b >> 4)])
        dst.WriteByte(digits[usize(b & 15)])
        i += 1
    }
}

// digit_of returns the value of a hexadecimal character, or -1 when it is not
// one. Either case is accepted.
func digit_of(ch: u8) -> i32 {
    var i: usize = 0
    for i < 16 {
        if lower_hex[i] == ch || upper_hex[i] == ch {
            return i32(i)
        }
        i += 1
    }
    return -1
}

// DecodeHex reads hexadecimal into an array. An odd number of characters and a
// character outside the sixteen are refused.
func DecodeHex(s: str) -> Result<Array<u8>, Error> {
    var n = s.Len()
    if n % 2 != 0 {
        return Result.Err(Error.InvalidLength)
    }
    var out = new Array<u8>(n / 2)
    var i: usize = 0
    for i < n {
        var hi = digit_of(s[i])
        if hi < 0 {
            return Result.Err(Error.InvalidChar(s[i]))
        }
        var lo = digit_of(s[i + 1])
        if lo < 0 {
            return Result.Err(Error.InvalidChar(s[i + 1]))
        }
        out.Push(u8(hi * 16 + lo))
        i += 2
    }
    return Result.Ok(out)
}
